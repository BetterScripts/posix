#  test_set_config
#  ---------------
#
#  Run tests for a specific library configuration.
#
#  NOTE: Preference based variables will be unset or set to specific values.
#        Variables required for platform workarounds will _not_ be changed if
#        currently set, but _may_ be set otherwise - this ensures platforms
#        that require workarounds don't try to use other code paths.
#_______________________________________________________________________________
test_set_config() { ## cSpell:Ignore BS_TRC_
  BS_TRC_Config=${1:?'[libdeque::failure::test_run_config]: Error: expected a configuration index'}

  #---------------------------------------------------------
  case ${BS_LIBDEQUE_CONFIG_ALLOW_UNSAFE_DATA_FORMAT:+1} in
  1) unset BS_LIBDEQUE_CONFIG_ALLOW_UNSAFE_DATA_FORMAT ;;
  esac
  #---------------------------------------------------------

  #---------------------------------------------------------
  #  Set Configuration Accordingly
  case ${BS_TRC_Config} in
    #...................................
    #  CONFIG: DEFAULT
    1)  test_print_config_info 'Config: DEFAULT' ;;

    #...................................
    #  CONFIG: ONE-BASED INDEXES
    2)  BS_LIBDEQUE_CONFIG_ALLOW_UNSAFE_DATA_FORMAT=1
        export BS_LIBDEQUE_CONFIG_ALLOW_UNSAFE_DATA_FORMAT

        test_print_config_info 'Config: ALLOW_UNSAFE_DATA_FORMAT' ;;

    #...................................
    #  CONFIG: UNKNOWN
    *)  return 1 ;;
  esac
}

