#:
#: ### `fn_bs_test_deque_push_usage`
#:
#: Tests invalid usage of `deque_push_back`/`deque_push_front`/`queue_push`/
#: `stack_push`.
#:
#: _TESTED COMMANDS_
#: <!-- -------- -->
#:
#: - `deque_push_back`
#: - `deque_push_front`
#: - `queue_push`
#: - `stack_push`
#:
#: _SYNOPSIS_
#: <!-- - -->
#:
#:      fn_bs_test_deque_push_usage
#:
#: _ARGUMENTS_
#: <!-- -- -->
#:
#: None.
#:
#_______________________________________________________________________________
fn_bs_test_deque_push_usage() { ## cSpell:Ignore BS_LDTF_
  set 'BS_DUMMY_PARAM' && shift  #< Clear positional parameters to avoid accidental usage

  #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  #  Invalid Argument Count (missing `DEQUE`)
  {
    TestOutput=; unset 'TestOutput'
    test_run_expect_failure         \
      ${LINENO:+"--line=${LINENO}"} \
      --output=TestOutput           \
      deque_push_back              || return $?

    test_assert ${LINENO:+"@${LINENO}"} "${TestOutput-}" -match '.*deque_push_back.*expected a deque variable.*values to add.*' || return $?
  }

  #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  #  Invalid Variable Name
  {
    TestOutput=; unset 'TestOutput'
    test_run_expect_failure         \
      ${LINENO:+"--line=${LINENO}"} \
      --output=TestOutput           \
      deque_push_front             \
        'Bad::Name'                \
        1                         || return $?

    test_assert ${LINENO:+"@${LINENO}"} "${TestOutput-}" -match '.*deque_push_front.*invalid variable name.*' || return $?
  }

  #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  #  Invalid Variable Name (`queue_push`)
  {
    TestOutput=; unset 'TestOutput'
    test_run_expect_failure         \
      ${LINENO:+"--line=${LINENO}"} \
