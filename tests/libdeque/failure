        '1BadName'                  \
        1                          || return $?

    test_assert ${LINENO:+"@${LINENO}"} "${TestOutput-}" -match '.*queue_push.*invalid variable name.*' || return $?
  }

  #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
