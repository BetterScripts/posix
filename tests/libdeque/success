#_______________________________________________________________________________
#  fn_bs_ldts_run_units
#  ----------------
#
#  Run all individual tests
#_______________________________________________________________________________
fn_bs_ldts_run_units() {
  #  Ensure always at least one argument so no issues with "$@"
  case $# in 0) set 'BS_DUMMY_PARAM' '--' && shift ;; esac

  #-------------------------------------
  #  deque_push_back
  test_run_unit                    \
    -u 'libdeque: deque_push_back' \
    'fn_bs_test_deque_push_back'   \
      ${1+"$@"}

  #-------------------------------------
  #  deque_push_front
  test_run_unit                     \
    -u 'libdeque: deque_push_front' \
    'fn_bs_test_deque_push_front'   \
      ${1+"$@"}

  #-------------------------------------
  #  deque_push_front
  test_run_unit                            \
    -u 'libdeque: deque push - pop - push' \
    'fn_bs_test_deque_push_pop_push'       \
      ${1+"$@"}

  #-------------------------------------
