#_______________________________________________________________________________
#  fn_bs_lstf_string_length_usage
#  --------------------
#
#  TESTS:   `string_length` (usage errors)
#_______________________________________________________________________________
fn_bs_lstf_string_length_usage() {
  set 'BS_DUMMY_PARAM' && shift  #< Clear positional parameters to avoid accidental usage

  #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  #  Invalid Argument Count (too many arguments)
  {
    TestOutput=; unset 'TestOutput'
    test_run_expect_failure   \
      ${LINENO:+"@${LINENO}"} \
      --output=TestOutput     \
      string_length           \
        'A' 'B' 'C'           || return $?

    test_assert ${LINENO:+"@${LINENO}"} "${TestOutput-}" -match '.*string_length.*expected.*text to measure.*' || return $?
  }

  #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  #  Invalid Variable Name
  {
    TestOutput=; unset 'TestOutput'
    test_run_expect_failure   \
      ${LINENO:+"@${LINENO}"} \
      --output=TestOutput     \
      string_length           \
        'Bad::Name'           \
        'a string'            || return $?

    test_assert ${LINENO:+"@${LINENO}"} "${TestOutput-}" -match '.*string_length.*invalid variable name.*' || return $?
  }
}

