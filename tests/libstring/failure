    test_assert ${LINENO:+"@${LINENO}"} "${TestOutput-}" -match '.*string_substr.*expected.*an offset.*' || return $?
  }

  #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  #  Invalid Argument Count (too many arguments)
  {
    TestOutput=; unset 'TestOutput'
    test_run_expect_failure   \
      ${LINENO:+"@${LINENO}"} \
      --output=TestOutput     \
      string_substr           \
        'A' 'B' 'C' 'D' 'E'   || return $?

    test_assert ${LINENO:+"@${LINENO}"} "${TestOutput-}" -match '.*string_substr.*expected.*an offset.*' || return $?
  }

  #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  #  Invalid Variable Name
  {
    TestOutput=; unset 'TestOutput'
    test_run_expect_failure   \
      ${LINENO:+"@${LINENO}"} \
      --output=TestOutput     \
      string_substr           \
        'Bad::Name'           \
        'a string'            \
        '1'                   || return $?

    test_assert ${LINENO:+"@${LINENO}"} "${TestOutput-}" -match '.*string_substr.*invalid variable name.*' || return $?
  }

  #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  #  Non-Numeric Offset
  {
    TestOutput=; unset 'TestOutput'
    test_run_expect_failure   \
      ${LINENO:+"@${LINENO}"} \
      --output=TestOutput     \
      string_substr           \
        'TestVar'             \
        'a string'            \
        'not-a-number'        || return $?

    test_assert ${LINENO:+"@${LINENO}"} "${TestOutput-}" -match ".*string_substr.*expected a whole number for offset ('not-a-number').*" || return $?
  }

  #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  #  Non-Numeric Length
  {
    TestOutput=; unset 'TestOutput'
    test_run_expect_failure   \
      ${LINENO:+"@${LINENO}"} \
      --output=TestOutput     \
      string_substr           \
        'TestVar'             \
        'a string'            \
        '1'                   \
        'not-a-number'        || return $?

    test_assert ${LINENO:+"@${LINENO}"} "${TestOutput-}" -match ".*string_substr.*and a whole number for length ('not-a-number').*" || return $?
  }

  #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  #  `OFFSET` of `0` (only invalid under the ONE-BASED-INDEX config)
  case ${BS_LIBSTRING_CONFIG_INDEX_ONE_BASED:+1} in
  1)
    TestOutput=; unset 'TestOutput'
    test_run_expect_failure   \
      ${LINENO:+"@${LINENO}"} \
      --output=TestOutput     \
      string_substr           \
        'TestVar'             \
        'a string'            \
        '0'                   || return $?

    test_assert ${LINENO:+"@${LINENO}"} "${TestOutput-}" -match ".*string_substr.*expected a whole number greater than 0 for offset ('0').*" || return $? ;;
  esac
}

