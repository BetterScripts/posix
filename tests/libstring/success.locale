  test_assert ${LINENO:+"@${LINENO}"} "${TestOutput}" = "${TestResult}" || return $?
  }
}

#_______________________________________________________________________________
#  fn_bs_lsts_string_sub
#  ------------------------------
fn_bs_lsts_string_sub() {
  set 'BS_DUMMY_PARAM' && shift  #< Clear positional parameters to avoid accidental usage

  #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

  BS_LSTS_TestSub1_Source='𝞣𝙝ȇ 𝗊ʉɩсḱ Ꮟ𝘳ǒẁ𝔫 ḑο𝘨 𝘫𝛖ṁ𝟈š 𝒐ṽⱸŕ ŧһℯ ḻ𝖺𝘇𝜸 ſᶉȫĝ'
  BS_LSTS_TestSub1_Target='𝞣𝙝ȇ 𝗊ʉɩсḱ Ꮟ𝘳ǒẁ𝔫 ſᶉȫĝ 𝘫𝛖ṁ𝟈š 𝒐ṽⱸŕ ŧһℯ ḻ𝖺𝘇𝜸 ſᶉȫĝ'
    BS_LSTS_TestSub1_Repl='ſᶉȫĝ'
  BS_LSTS_TestSub1_Expr_E='([ḑ𝘨].[ḑ𝘨])'
  BS_LSTS_TestSub1_Expr_F='ḑο𝘨'
  BS_LSTS_TestSub1_Expr_G='\([ḑ𝘨].\{1\}[ḑ𝘨]\)'
  BS_LSTS_TestSub1_Expr_W='[ḑ𝘨]?[ḑ𝘨]'

  #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

  BS_LSTS_TestSub2_Source='𝞣𝙝ȇ 𝗊ʉɩсḱ Ꮟ𝘳ǒẁ𝔫 ḑο𝘨 𝘫𝛖ṁ𝟈š
𝒐ṽⱸŕ ŧһℯ ḻ𝖺𝘇𝜸 ſᶉȫĝ'
  BS_LSTS_TestSub2_Target='𝞣𝙝ȇ 𝗊ʉɩсḱ Ꮟ𝘳ǒẁ𝔫 ſᶉȫĝ 𝘫𝛖ṁ𝟈š
𝒐ṽⱸŕ ŧһℯ ḻ𝖺𝘇𝜸 ſᶉȫĝ'
    BS_LSTS_TestSub2_Repl='ſᶉȫĝ'
  BS_LSTS_TestSub2_Expr_E='([ḑ𝘨].[ḑ𝘨])'
  BS_LSTS_TestSub2_Expr_F='ḑο𝘨'
  BS_LSTS_TestSub2_Expr_G='\([ḑ𝘨].\{1\}[ḑ𝘨]\)'
  BS_LSTS_TestSub2_Expr_W='[ḑ𝘨]?[ḑ𝘨]'

  #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

  BS_LSTS_TestSub3_Source='𝞣𝙝ȇ 𝗊ʉɩсḱ Ꮟ𝘳ǒẁ𝔫 ḑο𝘨
 𝘫𝛖ṁ𝟈š 𝒐ṽⱸŕ ŧһℯ ḻ𝖺𝘇𝜸 ſᶉȫĝ'
  BS_LSTS_TestSub3_Target='𝞣𝙝ȇ 𝗊ʉɩсḱ Ꮟ𝘳ǒẁ𝔫 ſᶉȫĝ 𝘫𝛖ṁ𝟈š 𝒐ṽⱸŕ ŧһℯ ḻ𝖺𝘇𝜸 ſᶉȫĝ'
    BS_LSTS_TestSub3_Repl='ſᶉȫĝ'
  BS_LSTS_TestSub3_Expr_E='([ḑ𝘨].[ḑ𝘨])\n'
  BS_LSTS_TestSub3_Expr_F='ḑο𝘨
'
  BS_LSTS_TestSub3_Expr_G='\([ḑ𝘨].\{1\}[ḑ𝘨]\)\n'
  BS_LSTS_TestSub3_Expr_W='[ḑ𝘨]?[ḑ𝘨]?'

  #=========================================================
  #
  #=========================================================
  for TestMode in E F G W
  do
    eval "
      BS_LSTS_TestSub1_Expr=\${BS_LSTS_TestSub1_Expr_${TestMode}}
      BS_LSTS_TestSub2_Expr=\${BS_LSTS_TestSub2_Expr_${TestMode}}
      BS_LSTS_TestSub3_Expr=\${BS_LSTS_TestSub3_Expr_${TestMode}}
    "

    #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    {
      TestSub=; unset TestSub
      test_run_expect_success             \
        ${LINENO:+"@${LINENO}"}           \
          --output=TestSub                \
          string_sub                      \
            "-${TestMode}"                \
            "${BS_LSTS_TestSub1_Source}"  \
            "${BS_LSTS_TestSub1_Expr-}"   \
            "${BS_LSTS_TestSub1_Repl}"    || return $?

      test_assert "@${LINENO-?} [${TestMode}]" "_${TestSub-}" = "_${BS_LSTS_TestSub1_Target}" || return $?
    }

    #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    {
      TestSub=; unset TestSub
      test_run_expect_success             \
        ${LINENO:+"@${LINENO}"}           \
          --output=TestSub                \
          string_sub                      \
            "-${TestMode}"                \
            "${BS_LSTS_TestSub2_Source}"  \
            "${BS_LSTS_TestSub2_Expr-}"   \
            "${BS_LSTS_TestSub2_Repl}"    || return $?

      test_assert "@${LINENO-?} [${TestMode}]" "_${TestSub-}" = "_${BS_LSTS_TestSub2_Target}" || return $?
    }

    #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    {
      TestSub=; unset TestSub
      test_run_expect_success             \
        ${LINENO:+"@${LINENO}"}           \
          --output=TestSub                \
          string_sub                      \
            "-${TestMode}"                \
            "${BS_LSTS_TestSub3_Source}"  \
            "${BS_LSTS_TestSub3_Expr-}"   \
            "${BS_LSTS_TestSub3_Repl}"    || return $?

      test_assert "@${LINENO-?} [${TestMode}]" "_${TestSub-}" = "_${BS_LSTS_TestSub3_Target}" || return $?
    }
  done
}

#_______________________________________________________________________________
#  fn_bs_lsts_string_gsub
#  ------------------------------
fn_bs_lsts_string_gsub() {
  set 'BS_DUMMY_PARAM' && shift  #< Clear positional parameters to avoid accidental usage

  #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

  BS_LSTS_TestGSub1_Source='𝒯𝗁𝕖 զű𝔦𝖈қ ъřᴏẇ𝐧 ᶁ٥ǵ 𝔧ùḿ𝕡ṣ ०ᴠề𝐫 𝚝ȟė ƚẳ𝚣ᶌ ᶁ٥ǵ'
  BS_LSTS_TestGSub1_Target='𝒯𝗁𝕖 զű𝔦𝖈қ ъřᴏẇ𝐧 𝒻𝓇௦𝗀 𝔧ùḿ𝕡ṣ ०ᴠề𝐫 𝚝ȟė ƚẳ𝚣ᶌ 𝒻𝓇௦𝗀'
  BS_LSTS_TestGSub1_Expr_E='([ᶁǵ].[ᶁǵ])'
  BS_LSTS_TestGSub1_Expr_G='\([ᶁǵ].\{1\}[ᶁǵ]\)'
  BS_LSTS_TestGSub1_Expr_W='[ᶁǵ]?[ᶁǵ]'

  #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

  BS_LSTS_TestGSub2_Source='𝒯𝗁𝕖 զű𝔦𝖈қ ъřᴏẇ𝐧 ᶁ٥ǵ 𝔧ùḿ𝕡ṣ
०ᴠề𝐫 𝚝ȟė ƚẳ𝚣ᶌ ǵ٥ᶁ'
  BS_LSTS_TestGSub2_Target='𝒯𝗁𝕖 զű𝔦𝖈қ ъřᴏẇ𝐧 𝒻𝓇௦𝗀 𝔧ùḿ𝕡ṣ
०ᴠề𝐫 𝚝ȟė ƚẳ𝚣ᶌ 𝒻𝓇௦𝗀'
  BS_LSTS_TestGSub2_Expr_E='([ᶁǵ].[ᶁǵ])'
  BS_LSTS_TestGSub2_Expr_G='\([ᶁǵ].\{1\}[ᶁǵ]\)'
  BS_LSTS_TestGSub2_Expr_W='[ᶁǵ]?[ᶁǵ]'

  #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

  BS_LSTS_TestGSub3_Source='𝒯𝗁𝕖 զű𝔦𝖈қ ъřᴏẇ𝐧 ᶁ٥ǵ
 𝔧ùḿ𝕡ṣ ०ᴠề𝐫 𝚝ȟė ƚẳ𝚣ᶌ ǵ٥ᶁ
'
  BS_LSTS_TestGSub3_Target='𝒯𝗁𝕖 զű𝔦𝖈қ ъřᴏẇ𝐧 𝒻𝓇௦𝗀 𝔧ùḿ𝕡ṣ ०ᴠề𝐫 𝚝ȟė ƚẳ𝚣ᶌ 𝒻𝓇௦𝗀'
  BS_LSTS_TestGSub3_Expr_E='([ᶁǵ].[ᶁǵ])\n'
  BS_LSTS_TestGSub3_Expr_G='\([ᶁǵ].\{1\}[ᶁǵ]\)\n'
  BS_LSTS_TestGSub3_Expr_W='[ᶁǵ]?[ᶁǵ]?'

  #=========================================================
  #
  #=========================================================
  for TestMode in E G W
  do
    eval "
      BS_LSTS_TestGSub1_Expr=\${BS_LSTS_TestGSub1_Expr_${TestMode}}
      BS_LSTS_TestGSub2_Expr=\${BS_LSTS_TestGSub2_Expr_${TestMode}}
      BS_LSTS_TestGSub3_Expr=\${BS_LSTS_TestGSub3_Expr_${TestMode}}
    "

    #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    {
      TestSub=; unset TestSub
      test_run_expect_success             \
        ${LINENO:+"@${LINENO}"}           \
          --output=TestSub                \
          string_gsub                     \
            "-${TestMode}"                \
            "${BS_LSTS_TestGSub1_Source}" \
            "${BS_LSTS_TestGSub1_Expr-}"  \
            '𝒻𝓇௦𝗀'                        || return $?

      test_assert "@${LINENO-?} [${TestMode}]" "_${TestSub-}" = "_${BS_LSTS_TestGSub1_Target}" || return $?

      TestSub=; unset TestSub
      test_run_expect_success             \
        ${LINENO:+"@${LINENO}"}           \
          --output=TestSub                \
          string_gsub                     \
            "-${TestMode}"                \
            "${BS_LSTS_TestGSub2_Source}" \
            "${BS_LSTS_TestGSub2_Expr-}"  \
            '𝒻𝓇௦𝗀'                        || return $?

      test_assert "@${LINENO-?} [${TestMode}]" "_${TestSub-}" = "_${BS_LSTS_TestGSub2_Target}" || return $?

      TestSub=; unset TestSub
      test_run_expect_success             \
        ${LINENO:+"@${LINENO}"}           \
          --output=TestSub                \
          string_gsub                     \
            "-${TestMode}"                \
            "${BS_LSTS_TestGSub3_Source}" \
            "${BS_LSTS_TestGSub3_Expr-}"  \
            '𝒻𝓇௦𝗀'                        || return $?

      test_assert "@${LINENO-?} [${TestMode}]" "_${TestSub-}" = "_${BS_LSTS_TestGSub3_Target}" || return $?
    }
  done

  #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  {
    TestSub=; unset TestSub
    test_run_expect_success             \
      ${LINENO:+"@${LINENO}"}           \
        --output=TestSub                \
        string_gsub                     \
          '-F'                          \
          "${BS_LSTS_TestGSub1_Source}" \
          'ᶁ٥ǵ'                         \
          '𝒻𝓇௦𝗀'                        || return $?

    test_assert ${LINENO:+"@${LINENO}"} "_${TestSub-}" = "_${BS_LSTS_TestGSub1_Target}" || return $?
  }
}

#===============================================================================
#  TEST MAIN
#===============================================================================

#_______________________________________________________________________________
#  fn_bs_lsts_run_units
#  ----------------
#
#
#_______________________________________________________________________________
fn_bs_lsts_run_units() {
  #  Ensure always at least one argument so no issues with "$@"
  case $# in 0) set 'BS_DUMMY_PARAM' '--' && shift ;; esac

  #-------------------------------------
  #  CONSTANTS
  test_run_unit               \
    -u 'libstring: constants' \
    'fn_bs_lsts_constants'    \
      "$@"

  #-------------------------------------
  #
  test_run_unit                   \
    -u 'libstring: string_length' \
    'fn_bs_lsts_string_length'    \
      "$@"

  #-------------------------------------
  #
  test_run_unit                  \
    -u 'libstring: string_quote' \
    'fn_bs_lsts_string_quote'    \
      "$@"

  #-------------------------------------
  #
  test_run_unit                 \
    -u 'libstring: string_join' \
    'fn_bs_lsts_string_join'    \
      "$@"

  #-------------------------------------
  #
  test_run_unit                                   \
    -u 'libstring: string_toupper/string_tolower' \
    'fn_bs_lsts_string_toupper_tolower'           \
      "$@"

  #-------------------------------------
  #
  test_run_unit                 \
    -u 'libstring: string_trim' \
    'fn_bs_lsts_string_trim'    \
      "$@"

  #-------------------------------------
  #
  test_run_unit                  \
    -u 'libstring: string_index' \
    'fn_bs_lsts_string_index'    \
      "$@"

  #-------------------------------------
  #
  test_run_unit                  \
    -u 'libstring: string_match' \
    'fn_bs_lsts_string_match'    \
      "$@"

  #-------------------------------------
  #
  test_run_unit                   \
    -u 'libstring: string_substr' \
    'fn_bs_lsts_string_substr'    \
      "$@"

  #-------------------------------------
  #
  test_run_unit                     \
    -u 'libstring: string_truncate' \
    'fn_bs_lsts_string_truncate'    \
      "$@"

  #-------------------------------------
  #
  test_run_unit                \
    -u 'libstring: string_sub' \
    'fn_bs_lsts_string_sub'    \
      "$@"

  #-------------------------------------
  #
  test_run_unit                 \
    -u 'libstring: string_gsub' \
    'fn_bs_lsts_string_gsub'    \
      "$@"
}

################################################################################
#  TESTWRAPPER Values & Commands
################################################################################

#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
#  FRIENDLY NAME
BS_TEST_NAME='libstring/success.locale'
export BS_TEST_NAME

#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
#  NUMBER OF AVAILABLE CONFIGURATIONS
BS_TEST_CONFIG_COUNT=2
export BS_TEST_CONFIG_COUNT

#_______________________________________________________________________________
#  test_set_config
#  ---------------
#
#  Run tests for a specific library configuration.
#
#  NOTE: Preference based variables will be unset or set to specific values.
#        Variables required for platform workarounds will _not_ be changed if
#        currently set, but _may_ be set otherwise - this ensures platforms
#        that require workarounds don't try to use other code paths.
#_______________________________________________________________________________
test_set_config() { ## cSpell:Ignore BS_TRC_
  BS_TRC_Config=${1:?'[libstring::success::test_run_config]: Error: expected a configuration index'}

  #---------------------------------------------------------
  case ${BS_LIBSTRING_CONFIG_INDEX_ONE_BASED:+1} in
  1) unset BS_LIBSTRING_CONFIG_INDEX_ONE_BASED ;;
  esac
  #---------------------------------------------------------

  #---------------------------------------------------------
  #  Set Configuration Accordingly
  BS_LSTS_STRING_FIRST_INDEX=0
  case ${BS_TRC_Config} in
    #...................................
    #  CONFIG: DEFAULT
    1)  test_print_config_info 'Config: DEFAULT' ;;

    #...................................
    #  CONFIG: ONE-BASED INDEXES
    2)  BS_LIBSTRING_CONFIG_INDEX_ONE_BASED=1
        export BS_LIBSTRING_CONFIG_INDEX_ONE_BASED

        BS_LSTS_STRING_FIRST_INDEX=1

        test_print_config_info 'Config: STRING_INDEX_ONE_BASED' ;;

    #...................................
    #  CONFIG: UNKNOWN
    *)  return 1 ;;
  esac
}

#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
#  NUMBER OF AVAILABLE CONFIGURATIONS
BS_TEST_PLATFORM_CONFIG_COUNT=6
export BS_TEST_PLATFORM_CONFIG_COUNT

#_______________________________________________________________________________
#  test_set_platform_config
#  ---------------
#
#  Run tests for a specific library configuration.
#
#  NOTE: Preference based variables will be unset or set to specific values.
#        Variables required for platform workarounds will _not_ be changed if
#        currently set, but _may_ be set otherwise - this ensures platforms
#        that require workarounds don't try to use other code paths.
#_______________________________________________________________________________
test_set_platform_config() { ## cSpell:Ignore BS_TRC_
  BS_TRC_PlatformConfig=${1:?'[libstring::success::test_run_config]: Error: expected a configuration index'}

  #BS_LIBSTRING_CONFIG_ALLOW_STRING_OPTIMIZATIONS
  #BS_LIBSTRING_CONFIG_ALLOW_EXPR
  # BS_LIBSTRING_CONFIG_NO_AWK_ARGV
  #BS_LIBSTRING_CONFIG_NO_TR_LOCALE_AWARE

  #---------------------------------------------------------
  #  Set Configuration Accordingly
  case ${BS_TRC_PlatformConfig} in
    #...................................
    #
    0) ;;

    #...................................
    #  CONFIG: No `tr` case classes
    1)
      : "${BS_LIBSTRING_CONFIG_NO_TR_CASE_CLASS:=1}"
      export BS_LIBSTRING_CONFIG_NO_TR_CASE_CLASS

      test_print_config_info 'Platform Config: NO_TR_CASE_CLASS' ;;

    #...................................
    #  CONFIG: ONLY ALLOW `$1`-`$9`
    2)
      : "${BS_LIBSTRING_CONFIG_NO_CASE_CHAR_CLASS:=1}"
      export BS_LIBSTRING_CONFIG_NO_CASE_CHAR_CLASS

      test_print_config_info 'Platform Config: NO_CASE_CHAR_CLASS' ;;

    #...................................
    #  CONFIG:
    3)
      : "${BS_LIBSTRING_CONFIG_NO_PARAM_EXPANSION_CHAR_CLASS:=1}"
      export BS_LIBSTRING_CONFIG_NO_PARAM_EXPANSION_CHAR_CLASS

      test_print_config_info 'Platform Config: NO_PARAM_EXPANSION_CHAR_CLASS' ;;

    #...................................
    #  CONFIG:
    4)
      : "${BS_LIBSTRING_CONFIG_ALLOW_STRING_OPTIMIZATIONS:=1}"
      export BS_LIBSTRING_CONFIG_ALLOW_STRING_OPTIMIZATIONS

      test_print_config_info 'Platform Config: ALLOW_STRING_OPTIMIZATIONS' ;;

    #...................................
    #  CONFIG:
    5)
      : "${BS_LIBSTRING_CONFIG_ALLOW_EXPR:=1}"
      export BS_LIBSTRING_CONFIG_ALLOW_EXPR

      test_print_config_info 'Platform Config: ALLOW_EXPR' ;;

    #...................................
    #  CONFIG:
    6)
      : "${BS_LIBSTRING_CONFIG_NO_AWK_ARGV:=1}"
      export BS_LIBSTRING_CONFIG_NO_AWK_ARGV

      test_print_config_info 'Platform Config: NO_AWK_ARGV' ;;

    #...................................
    #  CONFIG: UNKNOWN
    *)  return 1 ;;
  esac
}

#_______________________________________________________________________________
#  test_check_config
#  ---------------
#
#  Run tests for a specific library configuration.
#
#  NOTE: Preference based variables will be unset or set to specific values.
#        Variables required for platform workarounds will _not_ be changed if
#        currently set, but _may_ be set otherwise - this ensures platforms
#        that require workarounds don't try to use other code paths.
#_______________________________________________________________________________
test_check_config() { ## cSpell:Ignore BS_TCC_
  #---------------------------------------------------------
  #  Get Library File
  BS_TCC_Library=${1:?'[libstring::success::test_check_config]: Error: expected a library to source'}
  shift

  return
}

#_______________________________________________________________________________
#  test_run_all
#  ------------
#
#  Run tests for a specific library configuration.
#
#  NOTE: Preference based variables will be unset or set to specific values.
#        Variables required for platform workarounds will _not_ be changed if
#        currently set, but _may_ be set otherwise - this ensures platforms
#        that require workarounds don't try to use other code paths.
#_______________________________________________________________________________
test_run_all() { ## cSpell:Ignore BS_TRC_
  #---------------------------------------------------------
  #  Get Library File
  BS_TRC_Library=${1:?'[libstring::success::test_run_config]: Error: expected a library to source'}
  shift

  #---------------------------------------------------------
  test_print_config_info 'Type: NORMAL USAGE'
  #---------------------------------------------------------

  #---------------------------------------------------------
  # Source the tool
  # shellcheck source=SCRIPTDIR/../../libstring.sh
  . "${BS_TRC_Library:?}" || return $?
  #---------------------------------------------------------

  #---------------------------------------------------------
  #  Run the tests
  fn_bs_lsts_run_units ${1+"$@"}
  #---------------------------------------------------------
}

