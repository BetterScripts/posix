#_______________________________________________________________________________
#  fn_bs_lats_constants
#  --------------------
#
#  TESTS:   Constants Are Set (and look reasonable)
#_______________________________________________________________________________
fn_bs_lsts_constants() {
  set 'BS_DUMMY_PARAM' && shift  #< Clear positional parameters to avoid accidental usage

  #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  {
    test_assert ${LINENO:+"@${LINENO}"} -n "${BS_LIBSTRING_SOURCED-}" || return $?

    #-----------------------------------

    test_assert ${LINENO:+"@${LINENO}"} -n "${BS_LIBSTRING_VERSION_MAJOR-}" || return $?
    test_assert ${LINENO:+"@${LINENO}"} -n "${BS_LIBSTRING_VERSION_MINOR-}" || return $?
    test_assert ${LINENO:+"@${LINENO}"} -n "${BS_LIBSTRING_VERSION_PATCH-}" || return $?
    test_assert ${LINENO:+"@${LINENO}"} -n "${BS_LIBSTRING_VERSION_FULL-}"  || return $?
    test_assert ${LINENO:+"@${LINENO}"} -n "${BS_LIBSTRING_VERSION-}"       || return $?

    #  Check they are version numbers are actually numbers
    test_assert ${LINENO:+"@${LINENO}"} "${BS_LIBSTRING_VERSION_MAJOR-}" -notmatch ".*[^0123456789].*" || return $?
    test_assert ${LINENO:+"@${LINENO}"} "${BS_LIBSTRING_VERSION_MINOR-}" -notmatch ".*[^0123456789].*" || return $?
    test_assert ${LINENO:+"@${LINENO}"} "${BS_LIBSTRING_VERSION_PATCH-}" -notmatch ".*[^0123456789].*" || return $?
    test_assert ${LINENO:+"@${LINENO}"} "${BS_LIBSTRING_VERSION_FULL-}"  -notmatch ".*[^0123456789].*" || return $?

    test_assert ${LINENO:+"@${LINENO}"} "${BS_LIBSTRING_VERSION-}" -match "BetterScripts 'libstring' v.*" || return $?
  }
}

#_______________________________________________________________________________
#  fn_bs_lsts_string_length
#  --------------------
#
#  TESTS:   `string_length`
#_______________________________________________________________________________
fn_bs_lsts_string_length() {
  set 'BS_DUMMY_PARAM' && shift  #< Clear positional parameters to avoid accidental usage

  #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  TestString='Ҭհ𝕖 𝒒ữǐċꞣ ḃᵳǿẃņ Ⴛ𝓸𝑔 𝖏ǘм𝝔𝕤 𝕠𝛎ể𝙧 𝖙ĥ𝖊 ⱡậ𝔷ƴ 𝐟ɍ𝞼ḡ'
  TestLength=44

  #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  {
    TestOutput=; unset TestOutput
    test_run_expect_success   \
      ${LINENO:+"@${LINENO}"} \
        string_length         \
          'TestOutput'        \
          "${TestString}"     || return $?

    test_assert ${LINENO:+"@${LINENO}"} "${TestOutput}" -eq "${TestLength}" || return $?
  }

  #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  #  Single-argument form (`OUTPUT` omitted, output via `STDOUT`)
  {
    TestOutput=$(string_length "${TestString}") || return $?

    test_assert ${LINENO:+"@${LINENO}"} "${TestOutput}" -eq "${TestLength}" || return $?
  }
}

#_______________________________________________________________________________
#  fn_bs_lsts_string_quote
#  --------------------
#
#  TESTS:   `string_quote`
#_______________________________________________________________________________
fn_bs_lsts_string_quote() {
  set 'BS_DUMMY_PARAM' && shift  #< Clear positional parameters to avoid accidental usage

  #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  {
    TestString1='Ⅼǒ𝗋ẻḿ ᶖ𝔭ꞩ𝞾м'
    TestQuoted1="'Ⅼǒ𝗋ẻḿ ᶖ𝔭ꞩ𝞾м'"

    Quoted=; unset Quoted
    test_run_expect_success   \
      ${LINENO:+"@${LINENO}"} \
      string_quote            \
        'Quoted'              \
        "${TestString1}"       || return $?

    test_assert ${LINENO:+"@${LINENO}"} "_${Quoted}" = "_${TestQuoted1}" || return $?
  }

  #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  {
    TestString2='"ɗ𝗈ƚ𝐨ȓ ś𝔦𝜏 𝒶ᵯ𝗲𝓽,"'
    TestQuoted2="'\"ɗ𝗈ƚ𝐨ȓ ś𝔦𝜏 𝒶ᵯ𝗲𝓽,\"'"

    Quoted=; unset Quoted
    test_run_expect_success   \
      ${LINENO:+"@${LINENO}"} \
      string_quote            \
        'Quoted'              \
        "${TestString2}"       || return $?

    test_assert ${LINENO:+"@${LINENO}"} "_${Quoted}" = "_${TestQuoted2}" || return $?
  }

  #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  {
    TestString3='ƈổиṡé𝓬ʈê𝔱𝘶𝓻 ǡⅆḯꝑȉ𐑈𐐽𝙞ŉğ "
" 𝙚ιḭ𝞃,'
    TestQuoted3="'ƈổиṡé𝓬ʈê𝔱𝘶𝓻 ǡⅆḯꝑȉ𐑈𐐽𝙞ŉğ \"
\" 𝙚ιḭ𝞃,'"

    Quoted=; unset Quoted
    test_run_expect_success   \
      ${LINENO:+"@${LINENO}"} \
      string_quote            \
        'Quoted'              \
        "${TestString3}"      || return $?

    test_assert ${LINENO:+"@${LINENO}"} "_${Quoted}" = "_${TestQuoted3}" || return $?
  }

  #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  {
    TestString4='𐑈𝘦ḓ 𝑑õ '\''ëȋμ𝓼ṁ𝕠𝖉'\'' 𝕥ȩṃ𝕡๐г 𝞲𝓃𝔠𝑖𝑑𝚒ძυռṱ'
    TestQuoted4="'𐑈𝘦ḓ 𝑑õ '\''ëȋμ𝓼ṁ𝕠𝖉'\'' 𝕥ȩṃ𝕡๐г 𝞲𝓃𝔠𝑖𝑑𝚒ძυռṱ'"

    Quoted=; unset Quoted
    test_run_expect_success   \
      ${LINENO:+"@${LINENO}"} \
      string_quote            \
        'Quoted'              \
        "${TestString4}"       || return $?

    test_assert ${LINENO:+"@${LINENO}"} "_${Quoted}" = "_${TestQuoted4}" || return $?
  }
}

#_______________________________________________________________________________
#  fn_bs_lsts_string_join
#  --------------------
#
#  TESTS:   `string_join`
#_______________________________________________________________________________
fn_bs_lsts_string_join() {
  set 'BS_DUMMY_PARAM' && shift  #< Clear positional parameters to avoid accidental usage

  #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  TestString1='Ⅼǒ𝗋ẻḿ ᶖ𝔭ꞩ𝞾м'
  TestString2='"ɗ𝗈ƚ𝐨ȓ ś𝔦𝜏 𝒶ᵯ𝗲𝓽,"'
  TestString3='ƈổиṡé𝓬ʈê𝔱𝘶𝓻 ǡⅆḯꝑȉ𐑈𐐽𝙞ŉğ "
" 𝙚ιḭ𝞃,'
  TestJoined="${TestString1} ${TestString2} ${TestString3}"

  #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  {
    Joined=; unset Joined
    test_run_expect_success   \
      ${LINENO:+"@${LINENO}"} \
      string_join             \
        'Joined'              \
        "${TestString1}"      \
        "${TestString2}"      \
        "${TestString3}"      || return $?

    test_assert ${LINENO:+"@${LINENO}"} "_${Joined}" = "_${TestJoined}" || return $?
  }

  #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  {
    case $(
      (
        set 'BS_DUMMY_PARAM' 'S' 'U' 'C' 'C' 'E' 'S' 'S' && shift
        IFS="$(printf '_')" && export IFS
        printf '%s\n' "$*"
      ) 2>&1 || echo 'FAILED'
    ) in
    'S_U_C_C_E_S_S')
      (
        IFS="$(printf '_')" && export IFS

        Joined=; unset Joined
        test_run_expect_success   \
          ${LINENO:+"@${LINENO}"} \
          string_join             \
            'Joined'              \
            "${TestString1}"      \
            "${TestString2}"      \
            "${TestString3}"      || return $?

        test_assert ${LINENO:+"@${LINENO}"} "_${Joined}" = "_${TestJoined}" || return $?
      )
    ;;
    *) echo 'IFS not settable: skipping additional string join tests' ;;
    esac
  }
}

#_______________________________________________________________________________
#  fn_bs_lsts_string_toupper_tolower
#  --------------------
#
#  TESTS:   `string_toupper`/`string_tolower`
#_______________________________________________________________________________
fn_bs_lsts_string_toupper_tolower() { ## cSpell:Ignore toupper tolower
  set 'BS_DUMMY_PARAM' && shift  #< Clear positional parameters to avoid accidental usage

  #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  TestString1='А𝐛Ꞓ123 𝓍𝙔𝒛'
   TestUpper1='А𝐛Ꞓ123 𝓍𝙔𝒛'
   TestLower1='а𝐛ꞓ123 𝓍𝙔𝒛'

  #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  {
    TestOutput=; unset TestOutput
    test_run_expect_success   \
      ${LINENO:+"@${LINENO}"} \
        string_toupper        \
          'TestOutput'        \
          "${TestString1}"    || return $?

    test_assert ${LINENO:+"@${LINENO}"} "_${TestOutput}" = "_${TestUpper1}" || return $?
   }

  #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  {
    TestOutput=; unset TestOutput
    test_run_expect_success   \
      ${LINENO:+"@${LINENO}"} \
        string_tolower        \
          'TestOutput'        \
          "${TestString1}"    || return $?

    test_assert ${LINENO:+"@${LINENO}"} "_${TestOutput}" = "_${TestLower1}" || return $?
  }
}

#_______________________________________________________________________________
#  fn_bs_lsts_string_trim
#  --------------------
#
#  TESTS:   `string_trim`
#_______________________________________________________________________________
fn_bs_lsts_string_trim() {
  set 'BS_DUMMY_PARAM' && shift  #< Clear positional parameters to avoid accidental usage

  #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  TestString='   Ҭհ𝕖 𝒒ữǐċꞣ ḃᵳǿẃņ Ⴛ𝓸𝑔   '
  TestTrimmedAll='Ҭհ𝕖 𝒒ữǐċꞣ ḃᵳǿẃņ Ⴛ𝓸𝑔'
  TestTrimmedLeft='Ҭհ𝕖 𝒒ữǐċꞣ ḃᵳǿẃņ Ⴛ𝓸𝑔   '
  TestTrimmedRight='   Ҭհ𝕖 𝒒ữǐċꞣ ḃᵳǿẃņ Ⴛ𝓸𝑔'

  #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  #  Default (equivalent to `--all`)
  {
    TestOutput=; unset TestOutput
    test_run_expect_success   \
      ${LINENO:+"@${LINENO}"} \
        string_trim           \
          'TestOutput'        \
          "${TestString}"     || return $?

    test_assert ${LINENO:+"@${LINENO}"} "_${TestOutput}" = "_${TestTrimmedAll}" || return $?
  }

  #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  #  `--left`
  {
    TestOutput=; unset TestOutput
    test_run_expect_success   \
      ${LINENO:+"@${LINENO}"} \
        string_trim           \
          '--left'            \
          'TestOutput'        \
          "${TestString}"     || return $?

    test_assert ${LINENO:+"@${LINENO}"} "_${TestOutput}" = "_${TestTrimmedLeft}" || return $?
  }

  #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  #  `--right`
  {
    TestOutput=; unset TestOutput
    test_run_expect_success   \
      ${LINENO:+"@${LINENO}"} \
        string_trim           \
          '--right'           \
          'TestOutput'        \
          "${TestString}"     || return $?

    test_assert ${LINENO:+"@${LINENO}"} "_${TestOutput}" = "_${TestTrimmedRight}" || return $?
  }

  #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  #  `--all`
  {
    TestOutput=; unset TestOutput
    test_run_expect_success   \
      ${LINENO:+"@${LINENO}"} \
        string_trim           \
          '--all'             \
          'TestOutput'        \
          "${TestString}"     || return $?

    test_assert ${LINENO:+"@${LINENO}"} "_${TestOutput}" = "_${TestTrimmedAll}" || return $?
  }

  #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  #  Single-argument form (`OUTPUT` omitted, output via `STDOUT`)
  {
    TestOutput=$(string_trim "${TestString}") || return $?

    test_assert ${LINENO:+"@${LINENO}"} "_${TestOutput}" = "_${TestTrimmedAll}" || return $?
  }
}

#_______________________________________________________________________________
#  fn_bs_lsts_string_index
#  -----------------------------
fn_bs_lsts_string_index() {
  set 'BS_DUMMY_PARAM' && shift  #< Clear positional parameters to avoid accidental usage

  #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

  BS_LSTS_TestIdx1_Source='Ҭհ𝕖 𝒒ữǐċꞣ ḃᵳǿẃņ Ⴛ𝓸𝑔 𝖏ǘм𝝔𝕤 𝕠𝛎ể𝙧 𝖙ĥ𝖊 ⱡậ𝔷ƴ 𝐟ɍ𝞼ḡ'
  BS_LSTS_TestIdx1_Index=$(( 0 + BS_LSTS_STRING_FIRST_INDEX ))
  BS_LSTS_TestIdx1_Sub_E='Ҭհ𝕖'
  BS_LSTS_TestIdx1_Sub_F='Ҭհ𝕖'
  BS_LSTS_TestIdx1_Sub_G='Ҭհ𝕖'
  BS_LSTS_TestIdx1_Sub_W='Ҭհ𝕖'

  #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

  BS_LSTS_TestIdx2_Source='Ҭհ𝕖 𝒒ữǐċꞣ ḃᵳǿẃņ Ⴛ𝓸𝑔 𝖏ǘм𝝔𝕤
𝕠𝛎ể𝙧 𝖙ĥ𝖊 ⱡậ𝔷ƴ 𝐟ɍ𝞼ḡ'
  BS_LSTS_TestIdx2_Index=$(( 26 + BS_LSTS_STRING_FIRST_INDEX ))
  BS_LSTS_TestIdx2_Sub_E='([𝕠ữ]..[𝙧𝕤] )'
  BS_LSTS_TestIdx2_Sub_F='𝕠𝛎ể𝙧 '
  BS_LSTS_TestIdx2_Sub_G='\([𝕠ữ].\{2\}[𝙧𝕤] \)'
  BS_LSTS_TestIdx2_Sub_W='[𝕠ữ]??[𝙧𝕤] '

  #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

  BS_LSTS_TestIdx3_Source='Ҭհ𝕖 𝒒ữǐċꞣ ḃᵳǿẃņ Ⴛ𝓸𝑔
 𝖏ǘм𝝔𝕤 𝕠𝛎ể𝙧 𝖙ĥ𝖊 ⱡậ𝔷ƴ 𝐟ɍ𝞼ḡ'
  BS_LSTS_TestIdx3_Index=$(( 16 + BS_LSTS_STRING_FIRST_INDEX ))
  BS_LSTS_TestIdx3_Sub_E='([Ⴛ𝑔].[Ⴛ𝑔])\n'
  BS_LSTS_TestIdx3_Sub_F='Ⴛ𝓸𝑔
'
  BS_LSTS_TestIdx3_Sub_G='\([Ⴛ𝑔].\{1\}[Ⴛ𝑔]\)\n'
  BS_LSTS_TestIdx3_Sub_W='[Ⴛ𝑔]?[Ⴛ𝑔]?'

  #=========================================================
  #
  #=========================================================
  for TestMode in E F G W
  do
    eval "
      BS_LSTS_TestIdx1_Sub=\${BS_LSTS_TestIdx1_Sub_${TestMode}}
      BS_LSTS_TestIdx2_Sub=\${BS_LSTS_TestIdx2_Sub_${TestMode}}
      BS_LSTS_TestIdx3_Sub=\${BS_LSTS_TestIdx3_Sub_${TestMode}}
    "

    #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    {
      TestOutput=; unset TestOutput
      test_run_expect_success             \
        ${LINENO:+"@${LINENO}"}           \
          string_index                    \
            "-${TestMode}"                \
            'TestOutput'                  \
            "${BS_LSTS_TestIdx1_Source}"  \
            "${BS_LSTS_TestIdx1_Sub-}"    || return $?

      test_assert "@${LINENO-?} [${TestMode}]" "${TestOutput}" -eq "${BS_LSTS_TestIdx1_Index}" || return $?

      TestOutput=; unset TestOutput
      test_run_expect_success             \
        ${LINENO:+"@${LINENO}"}           \
          string_index                    \
            "-${TestMode}"                \
            'TestOutput'                  \
            "${BS_LSTS_TestIdx2_Source}"  \
            "${BS_LSTS_TestIdx2_Sub-}"    || return $?

      test_assert "@${LINENO-?} [${TestMode}]" "${TestOutput}" -eq "${BS_LSTS_TestIdx2_Index}" || return $?

      TestOutput=; unset TestOutput
      test_run_expect_success             \
        ${LINENO:+"@${LINENO}"}           \
          string_index                    \
            "-${TestMode}"                \
            'TestOutput'                  \
            "${BS_LSTS_TestIdx3_Source}"  \
            "${BS_LSTS_TestIdx3_Sub-}"    || return $?

      test_assert "@${LINENO-?} [${TestMode}]" "${TestOutput}" -eq "${BS_LSTS_TestIdx3_Index}" || return $?
    }
  done
}

#_______________________________________________________________________________
#  fn_bs_lsts_string_match
#  -----------------------------
fn_bs_lsts_string_match() {
  set 'BS_DUMMY_PARAM' && shift  #< Clear positional parameters to avoid accidental usage

  #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

  BS_LSTS_TestIdx1_Source='Ҭհ𝕖 𝒒ữǐċꞣ ḃᵳǿẃņ Ⴛ𝓸𝑔 𝖏ǘм𝝔𝕤 𝕠𝛎ể𝙧 𝖙ĥ𝖊 ⱡậ𝔷ƴ 𝐟ɍ𝞼ḡ'
  BS_LSTS_TestIdx1_Index=$(( 0 + BS_LSTS_STRING_FIRST_INDEX ))
  BS_LSTS_TestIdx1_Length=3
  BS_LSTS_TestIdx1_Sub_E='Ҭհ𝕖'
  BS_LSTS_TestIdx1_Sub_F='Ҭհ𝕖'
  BS_LSTS_TestIdx1_Sub_G='Ҭհ𝕖'
  BS_LSTS_TestIdx1_Sub_W='Ҭհ𝕖'

  #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

  BS_LSTS_TestIdx2_Source='Ҭհ𝕖 𝒒ữǐċꞣ ḃᵳǿẃņ Ⴛ𝓸𝑔 𝖏ǘм𝝔𝕤
𝕠𝛎ể𝙧 𝖙ĥ𝖊 ⱡậ𝔷ƴ 𝐟ɍ𝞼ḡ'
  BS_LSTS_TestIdx2_Index=$(( 26 + BS_LSTS_STRING_FIRST_INDEX ))
  BS_LSTS_TestIdx2_Length=5
  BS_LSTS_TestIdx2_Sub_E='([𝕠ữ]..[𝙧𝕤] )'
  BS_LSTS_TestIdx2_Sub_F='𝕠𝛎ể𝙧 '
  BS_LSTS_TestIdx2_Sub_G='\([𝕠ữ].\{2\}[𝙧𝕤] \)'
  BS_LSTS_TestIdx2_Sub_W='[𝕠ữ]??[𝙧𝕤] '

  #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

  BS_LSTS_TestIdx3_Source='Ҭհ𝕖 𝒒ữǐċꞣ ḃᵳǿẃņ Ⴛ𝓸𝑔
 𝖏ǘм𝝔𝕤 𝕠𝛎ể𝙧 𝖙ĥ𝖊 ⱡậ𝔷ƴ 𝐟ɍ𝞼ḡ'
  BS_LSTS_TestIdx3_Index=$(( 16 + BS_LSTS_STRING_FIRST_INDEX ))
  BS_LSTS_TestIdx3_Length=4
  BS_LSTS_TestIdx3_Sub_E='([Ⴛ𝑔].[Ⴛ𝑔])\n'
  BS_LSTS_TestIdx3_Sub_F='Ⴛ𝓸𝑔
'
  BS_LSTS_TestIdx3_Sub_G='\([Ⴛ𝑔].\{1\}[Ⴛ𝑔]\)\n'
  BS_LSTS_TestIdx3_Sub_W='[Ⴛ𝑔]?[Ⴛ𝑔]?'

  #=========================================================
  #
  #=========================================================
  for TestMode in E F G W
  do
    eval "
      BS_LSTS_TestIdx1_Sub=\${BS_LSTS_TestIdx1_Sub_${TestMode}}
      BS_LSTS_TestIdx2_Sub=\${BS_LSTS_TestIdx2_Sub_${TestMode}}
      BS_LSTS_TestIdx3_Sub=\${BS_LSTS_TestIdx3_Sub_${TestMode}}
    "

    #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    {
      test_run_expect_success             \
        ${LINENO:+"@${LINENO}"}           \
          string_match                    \
            "-${TestMode}"                \
            "${BS_LSTS_TestIdx1_Source}"  \
            "${BS_LSTS_TestIdx1_Sub-}"    || return $?

      test_assert "@${LINENO-?} [${TestMode}]" "${BS_LIBSTRING_MATCH_START-}"  -eq "${BS_LSTS_TestIdx1_Index}" || return $?
      test_assert "@${LINENO-?} [${TestMode}]" "${BS_LIBSTRING_MATCH_LENGTH-}" -eq "${BS_LSTS_TestIdx1_Length}" || return $?

      test_run_expect_success             \
        ${LINENO:+"@${LINENO}"}           \
          string_match                    \
            "-${TestMode}"                \
            "${BS_LSTS_TestIdx2_Source}"  \
            "${BS_LSTS_TestIdx2_Sub-}"    || return $?

      test_assert "@${LINENO-?} [${TestMode}]" "${BS_LIBSTRING_MATCH_START-}"  -eq "${BS_LSTS_TestIdx2_Index}" || return $?
      test_assert "@${LINENO-?} [${TestMode}]" "${BS_LIBSTRING_MATCH_LENGTH-}" -eq "${BS_LSTS_TestIdx2_Length}" || return $?

      test_run_expect_success             \
        ${LINENO:+"@${LINENO}"}           \
          string_match                    \
            "-${TestMode}"                \
            "${BS_LSTS_TestIdx3_Source}"  \
            "${BS_LSTS_TestIdx3_Sub-}"    || return $?

      test_assert "@${LINENO-?} [${TestMode}]" "${BS_LIBSTRING_MATCH_START-}"  -eq "${BS_LSTS_TestIdx3_Index}" || return $?
      test_assert "@${LINENO-?} [${TestMode}]" "${BS_LIBSTRING_MATCH_LENGTH-}" -eq "${BS_LSTS_TestIdx3_Length}" || return $?
    }
  done
}

#_______________________________________________________________________________
#  fn_bs_lsts_string_substr
#  ------------------------------
fn_bs_lsts_string_substr() {
  set 'BS_DUMMY_PARAM' && shift  #< Clear positional parameters to avoid accidental usage

  #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  TestString='ӑЬ𝙘𝐝ếƒ𝐠'
   TestIndex=3
  TestLength=3

  TestSubstr0='𝐝ếƒ'
  TestSubstr1='𝙘𝐝ế'

  #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  {
    TestOutput=; unset TestOutput
    test_run_expect_success   \
      ${LINENO:+"@${LINENO}"} \
        string_substr         \
          'TestOutput'        \
          "${TestString}"     \
          "${TestIndex}"      \
          "${TestLength}"     || return $?

    case ${BS_LSTS_STRING_FIRST_INDEX:-0} in
    0) test_assert ${LINENO:+"@${LINENO}"} "_${TestOutput}" = "_${TestSubstr0}" || return $? ;;
    1) test_assert ${LINENO:+"@${LINENO}"} "_${TestOutput}" = "_${TestSubstr1}" || return $? ;;
    esac
  }
}

#_______________________________________________________________________________
