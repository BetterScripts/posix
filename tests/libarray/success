      test_run_expect_failure          \
        ${LINENO:+"@${LINENO}"}        \
        array_search                   \
          'TestArray'                  \
          'TestIndex'                  \
          '='                          \
          "${c_BS_LATS__ArrayValue_4}" || return $?

      #.................................

      fn_bs_lats_verify_test_array "@${LINENO-}" 'TestArray' || return $?

      test_assert ${LINENO:+"@${LINENO}"} -z "${TestIndex:+1}" || return $?
    }
  }

  #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  #  Glob pattern
  {
    {
      TestIndex=; unset 'TestIndex'
      test_run_expect_success   \
        ${LINENO:+"@${LINENO}"} \
        array_search            \
          'TestArray'           \
          'TestIndex'           \
          '-like'               \
          '\[5]\(*'             || return $?

      #.................................

      fn_bs_lats_verify_test_array "@${LINENO-}" 'TestArray' || return $?

      test_assert ${LINENO:+"@${LINENO}"} -n "${TestIndex:+1}" || return $?
      test_assert ${LINENO:+"@${LINENO}"} "${TestIndex?}" -eq $((BS_LATS_ARRAY_FIRST_INDEX + 4)) || return $?
    }

    #-------------------------------------------------------
    #  Offset from previous index,
    #+ looking for a new value
    {
      test_run_expect_success   \
        ${LINENO:+"@${LINENO}"} \
        array_search            \
          'TestArray'           \
          'TestIndex'           \
          '-like'               \
          "\*6\**"            || return $?

      #.................................

      fn_bs_lats_verify_test_array "@${LINENO-}" 'TestArray' || return $?

      test_assert ${LINENO:+"@${LINENO}"} -n "${TestIndex:+1}" || return $?
      test_assert ${LINENO:+"@${LINENO}"} "${TestIndex?}" -eq $((BS_LATS_ARRAY_FIRST_INDEX + 5)) || return $?
    }

    #-------------------------------------------------------
    #  Offset from previous index,
    #+ looking for the same value
    {
      test_run_expect_failure   \
        ${LINENO:+"@${LINENO}"} \
        array_search            \
          'TestArray'           \
          'TestIndex'           \
          '-like'               \
          '\*6\**'            || return $?

      #.................................

      fn_bs_lats_verify_test_array "@${LINENO-}" 'TestArray' || return $?

      test_assert ${LINENO:+"@${LINENO}"} -z "${TestIndex:+1}" || return $?
    }
  }

  #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  #  Basic Regular Expression
  {
    {
      TestIndex=; unset 'TestIndex'
      test_run_expect_success   \
        ${LINENO:+"@${LINENO}"} \
        array_search            \
          'TestArray'           \
          'TestIndex'           \
          '-bre:s'              \
          '\(\[5\](.*\)'         || return $?

      #.................................

      fn_bs_lats_verify_test_array "@${LINENO-}" 'TestArray' || return $?

      test_assert ${LINENO:+"@${LINENO}"} -n "${TestIndex:+1}" || return $?
      test_assert ${LINENO:+"@${LINENO}"} "${TestIndex?}" -eq $((BS_LATS_ARRAY_FIRST_INDEX + 4)) || return $?
    }

    #-------------------------------------------------------
    #  Offset from previous index,
    #+ looking for a new value
    {
      test_run_expect_success   \
        ${LINENO:+"@${LINENO}"} \
        array_search            \
          'TestArray'           \
          'TestIndex'           \
          '-bre:s'              \
          '\*6\*.*'            || return $?

      #.................................

      fn_bs_lats_verify_test_array "@${LINENO-}" 'TestArray' || return $?

      test_assert ${LINENO:+"@${LINENO}"} -n "${TestIndex:+1}" || return $?
      test_assert ${LINENO:+"@${LINENO}"} "${TestIndex?}" -eq $((BS_LATS_ARRAY_FIRST_INDEX + 5)) || return $?
    }

    #-------------------------------------------------------
    #  Offset from previous index,
    #+ looking for the same value
    {
      test_run_expect_failure   \
        ${LINENO:+"@${LINENO}"} \
        array_search            \
          'TestArray'           \
          'TestIndex'           \
          '-bre'                \
          '[*]6\*.*'            || return $?

      #.................................

      fn_bs_lats_verify_test_array "@${LINENO-}" 'TestArray' || return $?

      test_assert ${LINENO:+"@${LINENO}"} -z "${TestIndex:+1}" || return $?
    }
  }

  #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  #  Extended Regular Expression
  {
    {
      TestIndex=; unset 'TestIndex'
      test_run_expect_success   \
        ${LINENO:+"@${LINENO}"} \
        array_search            \
          'TestArray'           \
          'TestIndex'           \
          '-ere:s'              \
          '(\[5]\(.*)'          || return $?

      #.................................

      fn_bs_lats_verify_test_array "@${LINENO-}" 'TestArray' || return $?

      test_assert ${LINENO:+"@${LINENO}"} -n "${TestIndex:+1}" || return $?
      test_assert ${LINENO:+"@${LINENO}"} "${TestIndex?}" -eq $((BS_LATS_ARRAY_FIRST_INDEX + 4)) || return $?
    }

    #-------------------------------------------------------
    #  Offset from previous index,
    #+ looking for a new value
    {
      test_run_expect_success   \
        ${LINENO:+"@${LINENO}"} \
        array_search            \
          'TestArray'           \
          'TestIndex'           \
          '-ere:s'              \
          '([*]6\*.*)'          || return $?

      #.................................

      fn_bs_lats_verify_test_array "@${LINENO-}" 'TestArray' || return $?

      test_assert ${LINENO:+"@${LINENO}"} -n "${TestIndex:+1}" || return $?
      test_assert ${LINENO:+"@${LINENO}"} "${TestIndex?}" -eq $((BS_LATS_ARRAY_FIRST_INDEX + 5)) || return $?
    }

    #-------------------------------------------------------
    #  Offset from previous index,
    #+ looking for the same value
    {
      test_run_expect_failure   \
        ${LINENO:+"@${LINENO}"} \
        array_search            \
          'TestArray'           \
          'TestIndex'           \
          '-ere'                \
          '([*]6\*.*)'          || return $?

      #.................................

      fn_bs_lats_verify_test_array "@${LINENO-}" 'TestArray' || return $?

      test_assert ${LINENO:+"@${LINENO}"} -z "${TestIndex:+1}" || return $?
    }
  }

  #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  #  by EXPRESSION
  #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  {
    for i in 1 2
    do
      #---------------------------------------------------
      for SearchTest in '-like|\[5]\(*'       '-notlike|\[5]\(*'                                   \
                        '-bre|\(\[5\](.*\)'     '-bre:m|\(\[5\](.*\)'     '-bre:s|\(\[5\](.*\)'     \
                        '-notbre|\(\[5\](.*\)'  '-notbre:m|\(\[5\](.*\)'  '-notbre:s|\(\[5\](.*\)'  \
                        '-ere|(\[5]\(.*)'       '-ere:m|(\[5]\(.*)'       '-ere:s|(\[5]\(.*)'         \
                        '-notere|(\[5]\(.*)'    '-notere:m|(\[5]\(.*)'    '-notere:s|(\[5]\(.*)'
      do
        TestPrimary=${SearchTest%%'|'*}
        TestExpression=${SearchTest#*'|'}

        #...................................................
        TestArray=; unset 'TestArray'
        case ${i} in
        1) fn_bs_lats_create_array  "@${LINENO-?} [${TestPrimary}]" 'TestArray' || return $? ;;
        2) fn_bs_lats_create_array2 "@${LINENO-?} [${TestPrimary}]" 'TestArray' || return $? ;;
        esac

        #...................................................
        TestIndex=; unset 'TestIndex'
        test_run_expect_success           \
          "@${LINENO-?} [${TestPrimary}]" \
            array_search                  \
            'TestArray'                   \
            'TestIndex'                   \
            "${TestPrimary}"              \
            "${TestExpression}"           || return $?

        #...................................................
        case ${i} in
        1) fn_bs_lats_verify_test_array  "@${LINENO-?} [${TestPrimary} (${i})]" 'TestArray' || return $? ;;
        2) fn_bs_lats_verify_test_array2 "@${LINENO-?} [${TestPrimary} (${i})]" 'TestArray' || return $? ;;
        esac

        #...................................................
        test_assert "@${LINENO-?} [${TestPrimary} (${i})]" -n "${TestIndex:+1}" || return $?

        case ${TestPrimary} in
        -not*) test_assert "@${LINENO-?} [${TestPrimary} (${i})]" "${TestIndex?}" -eq $((BS_LATS_ARRAY_FIRST_INDEX + 0)) || return $? ;;
            *) test_assert "@${LINENO-?} [${TestPrimary} (${i})]" "${TestIndex?}" -eq $((BS_LATS_ARRAY_FIRST_INDEX + 4)) || return $? ;;
        esac
      done
    done
  }
}

