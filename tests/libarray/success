#_______________________________________________________________________________
fn_bs_lats_array_remove() {
  set 'BS_DUMMY_PARAM' && shift  #< Clear positional parameters to avoid accidental usage

  #=============================================================================
  #  Remove ALL elements
  #=============================================================================
  {
    TestRangeBegin=$((BS_LATS_ARRAY_FIRST_INDEX + 0))
      TestRangeEnd=$((BS_LATS_ARRAY_FIRST_INDEX + c_BS_LATS__ArraySize))

    #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    #  by RANGE
    #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    {
      TestArray=; unset 'TestArray'
      fn_bs_lats_create_array "@${LINENO-}" 'TestArray' || return $?

      #.................................

      test_run_expect_success                 \
        ${LINENO:+"@${LINENO}"}               \
        array_remove                          \
          'TestArray'                         \
          "${TestRangeBegin}:${TestRangeEnd}" || return $?

      #.................................

      eval "set 'BS_DUMMY_PARAM' ${TestArray:+${TestArray}}" && shift || return $?

      test_assert ${LINENO:+"@${LINENO}"} $# -eq 0 || return $?
    }

    #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    #  by LENGTH
    #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    {
      TestArray=; unset 'TestArray'
      fn_bs_lats_create_array "@${LINENO-}" 'TestArray' || return $?

      #.................................

      test_run_expect_success                         \
        ${LINENO:+"@${LINENO}"}                       \
        array_remove                                  \
          'TestArray'                                 \
          "${TestRangeBegin}#${c_BS_LATS__ArraySize}" || return $?

      #.................................

      eval "set 'BS_DUMMY_PARAM' ${TestArray:+${TestArray}}" && shift || return $?

      test_assert ${LINENO:+"@${LINENO}"} $# -eq 0 || return $?
    }

    #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    #  by EXPRESSION
    #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    {
      for RemoveTest in '-like|*'                          \
                        '-bre|.*' '-bre:m|.*' '-bre:s|.*'  \
                        '-ere|.*' '-ere:m|.*' '-ere:s|.*'
      do
        TestPrimary=${RemoveTest%%'|'*}
        TestExpression=${RemoveTest#*'|'}

        #.................................

        TestArray=; unset 'TestArray'
        fn_bs_lats_create_array "@${LINENO-?} [${TestPrimary}]" 'TestArray' || return $?

        #.................................

        test_run_expect_success           \
          "@${LINENO-?} [${TestPrimary}]" \
          array_remove                    \
            'TestArray'                   \
            "${TestPrimary}"              \
            "${TestExpression}"           || return $?

        #.................................

        eval "set 'BS_DUMMY_PARAM' ${TestArray:+${TestArray}}" && shift || return $?

        test_assert "@${LINENO-?} [${TestPrimary}]" $# -eq 0 || return $?
      done
    }
  }

  #=============================================================================
  #  Remove SOME elements
  #=============================================================================
  {
     TestRangeBegin=$((BS_LATS_ARRAY_FIRST_INDEX + 1))
       TestRangeEnd=$((BS_LATS_ARRAY_FIRST_INDEX + 5))
    TestRangeLength=4

    #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    #  by RANGE
    #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    {
      TestArray=; unset 'TestArray'
      fn_bs_lats_create_array "@${LINENO-}" 'TestArray' || return $?

      #.................................

      test_run_expect_success                 \
        ${LINENO:+"@${LINENO}"}               \
        array_remove                          \
          'TestArray'                         \
          "${TestRangeBegin}:${TestRangeEnd}" || return $?

      #.................................

      eval "set 'BS_DUMMY_PARAM' ${TestArray:+${TestArray}}" && shift || return $?

      test_assert ${LINENO:+"@${LINENO}"} $# -eq $((c_BS_LATS__ArraySize - TestRangeLength)) || return $?
      test_assert ${LINENO:+"@${LINENO}"} "_${1-}" = "_${c_BS_LATS__ArrayValue_1}" || return $?
      test_assert ${LINENO:+"@${LINENO}"} "_${2-}" = "_${c_BS_LATS__ArrayValue_6}" || return $?
      test_assert ${LINENO:+"@${LINENO}"} "_${3-}" = "_${c_BS_LATS__ArrayValue_7}" || return $?
    }

    #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    #  by LENGTH
    #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    {
      TestArray=; unset 'TestArray'
      fn_bs_lats_create_array "@${LINENO-}" 'TestArray' || return $?

      #.................................

      test_run_expect_success                     \
        ${LINENO:+"@${LINENO}"}                   \
        array_remove                              \
          'TestArray'                             \
          "${TestRangeBegin}#${TestRangeLength}"  || return $?

      #.................................

      eval "set 'BS_DUMMY_PARAM' ${TestArray:+${TestArray}}" && shift || return $?

      test_assert ${LINENO:+"@${LINENO}"} $# -eq $((c_BS_LATS__ArraySize - TestRangeLength)) || return $?
      test_assert ${LINENO:+"@${LINENO}"} "_${1-}" = "_${c_BS_LATS__ArrayValue_1}" || return $?
      test_assert ${LINENO:+"@${LINENO}"} "_${2-}" = "_${c_BS_LATS__ArrayValue_6}" || return $?
      test_assert ${LINENO:+"@${LINENO}"} "_${3-}" = "_${c_BS_LATS__ArrayValue_7}" || return $?
    }

    #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    #  by EXPRESSION
    #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    {
      for i in 1 2
      do
        #---------------------------------------------------
        for RemoveTest in '-like|*[lL]*'          '-notlike|*[lL]*'                                   \
                          '-bre|.*\([lL]\).*'     '-bre:m|.*\([lL]\).*'     '-bre:s|.*\([lL]\).*'     \
                          '-notbre|.*\([lL]\).*'  '-notbre:m|.*\([lL]\).*'  '-notbre:s|.*\([lL]\).*'  \
                          '-ere|.*(l|L).*'        '-ere:m|.*(l|L).*'       '-ere:s|.*(l|L).*'         \
                          '-notere|.*(l|L).*'     '-notere:m|.*(l|L).*'    '-notere:s|.*(l|L).*'
        do
          TestPrimary=${RemoveTest%%'|'*}
          TestExpression=${RemoveTest#*'|'}

          #.................................................
          TestArray=;  TestValue1=; TestValue2=; TestValue3=;
          TestValue4=; TestValue5=; TestValue6=; TestValue7=;
          unset 'TestArray'  'TestValue1' 'TestValue2' \
                'TestValue3' 'TestValue4' 'TestValue5' \
                'TestValue6' 'TestValue7'
          case ${i} in
          1) fn_bs_lats_create_array  "@${LINENO-?} [${TestPrimary}]" 'TestArray' || return $?
             TestValue1=${c_BS_LATS__ArrayValue_1}
             TestValue2=${c_BS_LATS__ArrayValue_2}
             TestValue3=${c_BS_LATS__ArrayValue_3}
             TestValue4=${c_BS_LATS__ArrayValue_4}
             TestValue5=${c_BS_LATS__ArrayValue_5}
             TestValue6=${c_BS_LATS__ArrayValue_6}
             TestValue7=${c_BS_LATS__ArrayValue_7} ;;
          2) fn_bs_lats_create_array2 "@${LINENO-?} [${TestPrimary}]" 'TestArray' || return $?
             TestValue1=${c_BS_LATS__Array2Value_1}
             TestValue2=${c_BS_LATS__Array2Value_2}
             TestValue3=${c_BS_LATS__Array2Value_3}
             TestValue4=${c_BS_LATS__Array2Value_4}
             TestValue5=${c_BS_LATS__Array2Value_5}
             TestValue6=${c_BS_LATS__Array2Value_6}
             TestValue7=${c_BS_LATS__Array2Value_7} ;;
          esac

          #.................................................
          test_run_expect_success           \
            "@${LINENO-?} [${TestPrimary}]" \
            array_remove                    \
              'TestArray'                   \
              "${TestPrimary}"              \
              "${TestExpression}"           || return $?

          #.................................................
          test_run_expect_success   \
            ${LINENO:+"@${LINENO}"} \
            array_is_array          \
              'TestArray'           || return $?

          #.................................................
          eval "set 'BS_DUMMY_PARAM' ${TestArray:+${TestArray}}" && shift || return $?

          case ${TestPrimary} in
            -not*)
              test_assert "@${LINENO-?} [${TestPrimary} (${i})]" $# -eq 5 || return $?
              test_assert "@${LINENO-?} [${TestPrimary} (${i})]" "_${1-}" = "_${TestValue1}" || return $?
              test_assert "@${LINENO-?} [${TestPrimary} (${i})]" "_${2-}" = "_${TestValue2}" || return $?
              test_assert "@${LINENO-?} [${TestPrimary} (${i})]" "_${3-}" = "_${TestValue4}" || return $?
              test_assert "@${LINENO-?} [${TestPrimary} (${i})]" "_${4-}" = "_${TestValue6}" || return $?
              test_assert "@${LINENO-?} [${TestPrimary} (${i})]" "_${5-}" = "_${TestValue7}" || return $?
            ;;

            *)
              test_assert "@${LINENO-?} [${TestPrimary} (${i})]" $# -eq 2 || return $?
              test_assert "@${LINENO-?} [${TestPrimary} (${i})]" "_${1-}" = "_${TestValue3}" || return $?
              test_assert "@${LINENO-?} [${TestPrimary} (${i})]" "_${2-}" = "_${TestValue5}" || return $?
            ;;
          esac
        done
      done
    }
  }

  #=============================================================================
  #  Remove ONE element
  #=============================================================================
  {
          TestIndex=$((BS_LATS_ARRAY_FIRST_INDEX + 2))
     TestRangeBegin=$((BS_LATS_ARRAY_FIRST_INDEX + 2))
       TestRangeEnd=$((TestRangeBegin + 1))
    TestRangeLength=1

    #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    #  by INDEX
    #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    {
      TestArray=; unset 'TestArray'
      fn_bs_lats_create_array "@${LINENO-}" 'TestArray' || return $?

      #.................................

      test_run_expect_success   \
