#  ---------------
#
#  Run tests for a specific library configuration.
#
#  NOTE: Preference based variables will be unset or set to specific values.
#        Variables required for platform workarounds will _not_ be changed if
#        currently set, but _may_ be set otherwise - this ensures platforms
#        that require workarounds don't try to use other code paths.
#_______________________________________________________________________________
test_set_platform_config() { ## cSpell:Ignore BS_TRC_
  BS_TRC_PlatformConfig=${1:?'[libarray::failure::test_run_config]: Error: expected a configuration index'}

  ##########################################################
  # Tested:
  #   BS_LIBARRAY_CONFIG_NO_MULTIDIGIT_PARAMETER
  #   BS_LIBARRAY_CONFIG_NO_SHIFT_N
  #   BS_LIBARRAY_CONFIG_NO_DEV_NULL
  #   BS_LIBARRAY_CONFIG_NO_AWK_ARGV
  #
  # Untested:
  #   BS_LIBARRAY_CONFIG_NO_GREP_E
  ##########################################################

  #---------------------------------------------------------
  #  Set Configuration Accordingly
  case ${BS_TRC_PlatformConfig} in
    #...................................
    #
    0) ;;

    #...................................
    #  CONFIG: ONLY ALLOW `$1`-`$9`
    1)
      : "${BS_LIBARRAY_CONFIG_NO_MULTIDIGIT_PARAMETER:=1}"
      export BS_LIBARRAY_CONFIG_NO_MULTIDIGIT_PARAMETER

      test_print_config_info 'Platform Config: NO_MULTIDIGIT_PARAMETER' ;;

    #...................................
    #  CONFIG: NO `shift N`
    2)
      : "${BS_LIBARRAY_CONFIG_NO_SHIFT_N:=1}"
      export BS_LIBARRAY_CONFIG_NO_SHIFT_N

      test_print_config_info 'Platform Config: NO_SHIFT_N' ;;

    #...................................
    #  CONFIG: NO `/dev/null`
    3)
      : "${BS_LIBARRAY_CONFIG_NO_DEV_NULL:=1}"
      export BS_LIBARRAY_CONFIG_NO_DEV_NULL

      test_print_config_info 'Platform Config: NO_DEV_NULL';;

    #...................................
    #  CONFIG: NO `awk` `ARGV[...]`
    4)
      : "${BS_LIBARRAY_CONFIG_NO_AWK_ARGV:=1}"
      export BS_LIBARRAY_CONFIG_NO_AWK_ARGV

      test_print_config_info 'Platform Config: NO_AWK_ARGV';;

    #...................................
    #  CONFIG: UNKNOWN
    *)  return 1 ;;
  esac
}

