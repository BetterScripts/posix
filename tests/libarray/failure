#_______________________________________________________________________________
#  test_set_config
#  ---------------
#
#  Run tests for a specific library configuration.
#
#  NOTE: Preference based variables will be unset or set to specific values.
#        Variables required for platform workarounds will _not_ be changed if
#        currently set, but _may_ be set otherwise - this ensures platforms
#        that require workarounds don't try to use other code paths.
#_______________________________________________________________________________
test_set_config() { ## cSpell:Ignore BS_TRC_
  BS_TRC_Config=${1:?'[libarray::failure::test_run_config]: Error: expected a configuration index'}

  ##########################################################
  # Tested:
  #   BS_LIBARRAY_CONFIG_START_INDEX_ONE
  #   BS_LIBARRAY_CONFIG_FIND_REDIRECT_FD_1
  #   BS_LIBARRAY_CONFIG_FIND_REDIRECT_FD_2
  #
  # Untested:
  #   BS_LIBARRAY_CONFIG_QUIET_ERRORS
  #   BS_LIBARRAY_CONFIG_FATAL_ERRORS
  ##########################################################

  #---------------------------------------------------------
  case ${BS_LIBARRAY_CONFIG_START_INDEX_ONE:+1} in
  1) unset BS_LIBARRAY_CONFIG_START_INDEX_ONE ;;
  esac
  case ${BS_LIBARRAY_CONFIG_FIND_REDIRECT_FD_1:+1} in
  1) unset BS_LIBARRAY_CONFIG_FIND_REDIRECT_FD_1 ;;
  esac
  case ${BS_LIBARRAY_CONFIG_FIND_REDIRECT_FD_2:+1} in
  1) unset BS_LIBARRAY_CONFIG_FIND_REDIRECT_FD_2 ;;
  esac
  #---------------------------------------------------------

  #---------------------------------------------------------
  #  Set Configuration Accordingly
  BS_LATS_ARRAY_FIRST_INDEX=0
  case ${BS_TRC_Config} in
    #...................................
    #  CONFIG: DEFAULT
    1)  test_print_config_info 'Config: DEFAULT' ;;

    #...................................
    #  CONFIG: ONE-BASED INDEXES
    2)  BS_LIBARRAY_CONFIG_START_INDEX_ONE=1
        export BS_LIBARRAY_CONFIG_START_INDEX_ONE

        BS_LATS_ARRAY_FIRST_INDEX=1     #< Alternate Array index offset

        test_print_config_info 'Config: START_INDEX_ONE' ;;

    #...................................
    #  CONFIG: FIND FILE DESCRIPTORS
    3)  BS_LIBARRAY_CONFIG_FIND_REDIRECT_FD_1=9
        export BS_LIBARRAY_CONFIG_FIND_REDIRECT_FD_1
        BS_LIBARRAY_CONFIG_FIND_REDIRECT_FD_2=8
        export BS_LIBARRAY_CONFIG_FIND_REDIRECT_FD_2

        test_print_config_info 'Config: FIND_REDIRECT_FD' ;;

    #...................................
    #  CONFIG: UNKNOWN
    *)  return 1 ;;
  esac
}

