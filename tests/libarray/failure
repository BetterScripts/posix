  test_run_expect_success                               \
    ${BS_LATF_CA_LINENO:+"--line=${BS_LATF_CA_LINENO}"} \
    array_new                                           \
      'BS_LATF_CA_Array'                                \
      "${c_BS_LATF__ArrayValue_1}"                      \
      "${c_BS_LATF__ArrayValue_2}"                      \
      "${c_BS_LATF__ArrayValue_3}"                      \
      "${c_BS_LATF__ArrayValue_4}"                      \
