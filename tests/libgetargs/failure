fn_bs_test_multiple_set() {
   TestOutput=; unset 'TestOutput' 'TargetPath'
  test_run_expect_failure                           \
    --output=TestOutput                             \
    getargs                                         \
      --options 'destination|target|t[:]TargetPath' \
      --                                            \
      --target '/dev/null'                          \
      --target '/tmp'                               || return $?

  test_assert ${LINENO:+"@${LINENO}"} "${TestOutput-}" -match '.*Multiple values for single value option.*' || return $?
}

