#_______________________________________________________________________________
#  test_set_config
#  ---------------
#
#  Run tests for a specific library configuration.
#
#  NOTE: Preference based variables will be unset or set to specific values.
#        Variables required for platform workarounds will _not_ be changed if
#        currently set, but _may_ be set otherwise - this ensures platforms
#        that require workarounds don't try to use other code paths.
#_______________________________________________________________________________
test_set_config() { ## cSpell:Ignore BS_TRC_
  BS_TRC_Config=${1:?'[libgetargs::success::test_run_config]: Error: expected a configuration index'}

  #---------------------------------------------------------
  # Untested:
  #   BS_LIBGETARGS_CONFIG_TRUE_VALUE
  #   BS_LIBGETARGS_CONFIG_FALSE_VALUE
  #   BS_LIBGETARGS_CONFIG_OPTIONAL_VALUE
  #   BS_LIBGETARGS_CONFIG_HELP_WRAP_COLUMNS
  #   BS_LIBGETARGS_CONFIG_HELP_MULTI_OPTION
  #   BS_LIBGETARGS_CONFIG_HELP_MULTI_OPERAND
  #   BS_LIBGETARGS_CONFIG_HELP_ALTERNATIVE_OPERAND
  #---------------------------------------------------------

  #---------------------------------------------------------
  case ${BS_LIBGETARGS_CONFIG_ALLOW_AMBIGUOUS:+1} in
  1) unset BS_LIBGETARGS_CONFIG_ALLOW_AMBIGUOUS ;;
  esac

  case ${BS_LIBGETARGS_CONFIG_ALLOW_UNSAFE_OPTIONS:+1} in
  1) unset BS_LIBGETARGS_CONFIG_ALLOW_UNSAFE_OPTIONS ;;
  esac

  case ${BS_LIBGETARGS_CONFIG_INTERLEAVED_OPERANDS:+1} in
  1) unset BS_LIBGETARGS_CONFIG_INTERLEAVED_OPERANDS ;;
  esac
  #---------------------------------------------------------

  #---------------------------------------------------------
  #  Set Configuration Accordingly
  case ${BS_TRC_Config} in
    #...................................
    #  CONFIG: DEFAULT
    1)  test_print_config_info 'Config: DEFAULT' ;;

    #...................................
    #  CONFIG:
    2)  BS_LIBGETARGS_CONFIG_ALLOW_AMBIGUOUS=1
        export BS_LIBGETARGS_CONFIG_ALLOW_AMBIGUOUS

        test_print_config_info 'Config: ALLOW_AMBIGUOUS' ;;

    #...................................
    #  CONFIG:
    3)  BS_LIBGETARGS_CONFIG_ALLOW_UNSAFE_OPTIONS=1
        export BS_LIBGETARGS_CONFIG_ALLOW_UNSAFE_OPTIONS

        test_print_config_info 'Config: ALLOW_UNSAFE_OPTIONS' ;;

    #...................................
    #  CONFIG:
    4)  BS_LIBGETARGS_CONFIG_INTERLEAVED_OPERANDS=1
        export BS_LIBGETARGS_CONFIG_INTERLEAVED_OPERANDS

        test_print_config_info 'Config: INTERLEAVED_OPERANDS' ;;

    #...................................
    #  CONFIG:
    5)  BS_LIBGETARGS_CONFIG_ALLOW_AMBIGUOUS=1
        export BS_LIBGETARGS_CONFIG_ALLOW_AMBIGUOUS
        BS_LIBGETARGS_CONFIG_ALLOW_UNSAFE_OPTIONS=1
        export BS_LIBGETARGS_CONFIG_ALLOW_UNSAFE_OPTIONS
        BS_LIBGETARGS_CONFIG_INTERLEAVED_OPERANDS=1
        export BS_LIBGETARGS_CONFIG_INTERLEAVED_OPERANDS

        test_print_config_info 'Config: ALLOW_AMBIGUOUS + UNSAFE + INTERLEAVED' ;;

    #...................................
    #  CONFIG: UNKNOWN
    *)  return 1 ;;
  esac
}

