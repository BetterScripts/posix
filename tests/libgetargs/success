#-------------------------------------------------------------------------------
#  Default Validator ('getargs_validate_option_value')
#-------------------------------------------------------------------------------
fn_bs_test_default_validator() {
  #  NOTE: `--output` runs the command in a subshell (via command
  #  substitution), so `TargetPath` would not be visible afterwards if it were
  #  used here - checked in a separate invocation below instead.
  TargetPath=;  unset 'TargetPath'
  test_run_expect_success               \
    getargs                             \
      --options 'target|t[:]TargetPath' \
      --validate                        \
      --                                \
      --target '-suspicious-value'      || return $?

  #  Default validator only warns, it does not fail 'getargs' or change the value
  test_assert ${LINENO:+"@${LINENO}"} "${TargetPath-}" = '-suspicious-value' || return $?

  #.....................................
  #.....................................
  # HACK:
  # - ksh v93u+ (solaris) fails with the
  #   following test due to test
  #   harness issues which are difficult
  #   to diagnose, but do not seem to
  #   represent failures in the actual
  #   test. The cause seems to be
  #   related to `STDERR` capture in
  #   command substitution, but only in
  #   certain conditions (and what these
  #   are is unclear).
  case ${KSH_VERSION-} in
  'Version AJM 93u+ '*)
    echo 'Skipping additional tests for default validator: ksh v93u+ has unresolved issues with the test harness for these tests (causing false negatives).'
    return ;;
  esac
  #.....................................
  #.....................................

  TestOutput=;  unset 'TestOutput'
  TargetPath=;  unset 'TargetPath'
  test_run_expect_success               \
    --output=TestOutput                 \
    getargs                             \
      --options 'target|t[:]TargetPath' \
      --validate                        \
      --                                \
      --target '-suspicious-value'      || return $?

  test_assert ${LINENO:+"@${LINENO}"} "${TestOutput-}" -match '.*looks like an option.*' || return $?
}

