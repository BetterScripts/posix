    'fn_bs_test_optional_value_option'     \
    "$@"

  #-------------------------------------
  #  BS_LIBGETARGS_CONFIG_OPTIONAL_VALUE
  test_run_unit                                            \
    -u 'libgetargs: BS_LIBGETARGS_CONFIG_OPTIONAL_VALUE'   \
    'fn_bs_test_optional_value_config'                     \
    "$@"

  #-------------------------------------
  #  Difficult values
  test_run_unit                       \
    -u 'libgetargs: Difficult Values' \
    'fn_bs_test_difficult_values'     \
    "$@"

  #-------------------------------------
  #  Combined Switches & Values
  test_run_unit                                 \
    -u 'libgetargs: Combined Switches & Values' \
    'fn_bs_test_combined_flags_and_values'      \
    "$@"

  #-------------------------------------
  #  Extra Options
  test_run_unit                    \
    -u 'libgetargs: Extra Options' \
    'fn_bs_test_extra_options'     \
    "$@"

  #-------------------------------------
  #  Tagged Multiple Value Option
  test_run_unit                                   \
    -u 'libgetargs: Tagged Multiple Value Option' \
    'fn_bs_test_tagged_multiple_value_option'     \
    "$@"

  #-------------------------------------
  #  Validator
  test_run_unit                   \
    -u 'libgetargs: Validator'    \
    'fn_bs_test_option_validator' \
    "$@"

  #-------------------------------------
  #  Default Validator
  test_run_unit                       \
    -u 'libgetargs: Default Validator' \
    'fn_bs_test_default_validator'    \
    "$@"

  #-------------------------------------
  #  Automatic Unset
  test_run_unit                      \
    -u 'libgetargs: Automatic Unset' \
    'fn_bs_test_automatic_unset'     \
    "$@"

  #-------------------------------------
  #  Auto-Help
  test_run_unit                 \
    -u 'libgetargs: Auto-Help' \
    'fn_bs_test_auto_help'    \
    "$@"

  #-------------------------------------
  #  Script Mode
  test_run_unit                  \
    -u 'libgetargs: Script Mode' \
    'fn_bs_test_script_mode'     \
    "$@"

