fn_bs_test_tagged_flags() {
  #  Default
  fn_bs_test_tagged_flags_with_val         \
    "${BS_LIBGETARGS_CONFIG_TRUE_VALUE?}"  \
    "${BS_LIBGETARGS_CONFIG_FALSE_VALUE?}" || return $?

