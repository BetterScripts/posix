#_______________________________________________________________________________
#  fn_bs_lpts_constants
#  --------------------
#
#  TESTS:   Constants Are Set (and look reasonable)
#_______________________________________________________________________________
fn_bs_lpts_constants() {
  set 'BS_DUMMY_PARAM' && shift  #< Clear positional parameters to avoid accidental usage

  #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  {
    test_assert ${LINENO:+"@${LINENO}"} -n "${BS_LIBPATH_SOURCED-}" || return $?

    #-----------------------------------

    test_assert ${LINENO:+"@${LINENO}"} -n "${BS_LIBPATH_VERSION_MAJOR-}" || return $?
    test_assert ${LINENO:+"@${LINENO}"} -n "${BS_LIBPATH_VERSION_MINOR-}" || return $?
    test_assert ${LINENO:+"@${LINENO}"} -n "${BS_LIBPATH_VERSION_PATCH-}" || return $?
    test_assert ${LINENO:+"@${LINENO}"} -n "${BS_LIBPATH_VERSION_FULL-}"  || return $?
    test_assert ${LINENO:+"@${LINENO}"} -n "${BS_LIBPATH_VERSION-}"       || return $?

    #  Check they are version numbers are actually numbers
    test_assert ${LINENO:+"@${LINENO}"} "${BS_LIBPATH_VERSION_MAJOR-}" -notmatch ".*[^0123456789].*" || return $?
    test_assert ${LINENO:+"@${LINENO}"} "${BS_LIBPATH_VERSION_MINOR-}" -notmatch ".*[^0123456789].*" || return $?
    test_assert ${LINENO:+"@${LINENO}"} "${BS_LIBPATH_VERSION_PATCH-}" -notmatch ".*[^0123456789].*" || return $?
    test_assert ${LINENO:+"@${LINENO}"} "${BS_LIBPATH_VERSION_FULL-}"  -notmatch ".*[^0123456789].*" || return $?

    test_assert ${LINENO:+"@${LINENO}"} "${BS_LIBPATH_VERSION-}" -match "BetterScripts 'libpath' v.*" || return $?
  }
}

