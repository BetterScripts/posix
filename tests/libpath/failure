#_______________________________________________________________________________
#  test_set_config
#  ---------------
#
#  Run tests for a specific library configuration.
#
#  NOTE: Preference based variables will be unset or set to specific values.
#        Variables required for platform workarounds will _not_ be changed if
#        currently set, but _may_ be set otherwise - this ensures platforms
#        that require workarounds don't try to use other code paths.
#_______________________________________________________________________________
test_set_config() { ## cSpell:Ignore BS_TRC_
  BS_TRC_Config=${1:?'[libpath::failure::test_run_config]: Error: expected a configuration index'}

  #---------------------------------------------------------
  case ${BS_LIBPATH_CONFIG_NO_MKTEMP:+1} in
  1) unset BS_LIBPATH_CONFIG_NO_MKTEMP ;;
  esac

  case ${BS_LIBPATH_CONFIG_PREFER_HEXDUMP:+1} in
  1) unset BS_LIBPATH_CONFIG_PREFER_HEXDUMP ;;
  esac
  case ${BETTER_SCRIPTS_CONFIG_PREFER_HEXDUMP:+1} in
  1) unset BETTER_SCRIPTS_CONFIG_PREFER_HEXDUMP ;;
  esac

  case ${BS_LIBPATH_CONFIG_RANDOM_SOURCE:+1} in
  1) unset BS_LIBPATH_CONFIG_RANDOM_SOURCE ;;
  esac
  case ${BETTER_SCRIPTS_CONFIG_RANDOM_SOURCE:+1} in
  1) unset BETTER_SCRIPTS_CONFIG_RANDOM_SOURCE ;;
  esac
  #---------------------------------------------------------

  #---------------------------------------------------------
  #  Set Configuration Accordingly
  case ${BS_TRC_Config} in
    #...................................
    #  CONFIG: DEFAULT
    1) test_print_config_info 'Config: DEFAULT' ;;

    #...................................
    #  CONFIG: NO MKTEMP
    2)  BS_LIBPATH_CONFIG_NO_MKTEMP=1
        export BS_LIBPATH_CONFIG_NO_MKTEMP

        test_print_config_info 'Config: NO_MKTEMP' ;;

    #...................................
    #  CONFIG: PREFER HEXDUMP
    3)  BS_LIBPATH_CONFIG_NO_MKTEMP=1
        export BS_LIBPATH_CONFIG_NO_MKTEMP
        BETTER_SCRIPTS_CONFIG_PREFER_HEXDUMP=1
        export BETTER_SCRIPTS_CONFIG_PREFER_HEXDUMP

        test_print_config_info                 \
          'Config: NO_MKTEMP + PREFER_HEXDUMP' \
          'Type:   INVALID USAGE'              ;;

    #...................................
    #  CONFIG: RANDOM SOURCE
    4)  BS_LIBPATH_CONFIG_NO_MKTEMP=1
        export BS_LIBPATH_CONFIG_NO_MKTEMP
        BS_LIBPATH_CONFIG_RANDOM_SOURCE='/dev/random'
        export BS_LIBPATH_CONFIG_RANDOM_SOURCE

        test_print_config_info                \
          'Config: NO_MKTEMP + RANDOM_SOURCE' \
          'Type:   INVALID USAGE'             ;;

    #...................................
    #  CONFIG: `awk`
    5)  BS_LIBPATH_CONFIG_NO_MKTEMP=1
        export BS_LIBPATH_CONFIG_NO_MKTEMP
        BS_LIBPATH_CONFIG_RANDOM_SOURCE='awk'
        export BS_LIBPATH_CONFIG_RANDOM_SOURCE

        test_print_config_info                    \
          'Config: NO_MKTEMP + RANDOM_SOURCE=awk' \
          'Type:   INVALID USAGE'                 ;;

    #...................................
    #  CONFIG: UNKNOWN
    *)  return 1 ;;
  esac
}

