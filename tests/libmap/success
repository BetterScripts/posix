fn_bs_lmts_run_units() {
  #  Ensure always at least one argument so no issues with "$@"
  case $# in 0) set 'BS_DUMMY_PARAM' '--' && shift ;; esac

  #-------------------------------------
  #  CONSTANTS
  test_run_unit            \
    -u 'libmap: constants' \
    'fn_bs_lmts_constants' \
      "$@"

  #-------------------------------------
  #
  test_run_unit          \
    -u 'libmap: map_new' \
    'fn_bs_lmts_map_new' \
      "$@"

  #-------------------------------------
  #
  test_run_unit                  \
    -u 'libmap: map_add/get'     \
    'fn_bs_lmts_map_add_and_get' \
      "$@"

  #-------------------------------------
  #
  test_run_unit          \
    -u 'libmap: map_add' \
    'fn_bs_lmts_map_add' \
      "$@"

  #-------------------------------------
  #
  test_run_unit          \
    -u 'libmap: map_set' \
    'fn_bs_lmts_map_set' \
      "$@"

  #-------------------------------------
  #
  test_run_unit                          \
    -u 'libmap: map_contains'            \
    'fn_bs_lmts_map_contains_and_is_map' \
      "$@"

  #-------------------------------------
  #
  test_run_unit             \
    -u 'libmap: map_delete' \
    'fn_bs_lmts_map_delete' \
      "$@"

  #-------------------------------------
  #
  test_run_unit           \
    -u 'libmap: map_size' \
    'fn_bs_lmts_map_size' \
      "$@"

  #-------------------------------------
  #
  test_run_unit              \
    -u 'libmap: map_foreach' \
    'fn_bs_lmts_map_foreach' \
      "$@"

  #-------------------------------------
  #
  test_run_unit                      \
    -u 'libmap: map_keys/values'     \
    'fn_bs_lmts_map_keys_and_values' \
      "$@"
}

