#_______________________________________________________________________________
#  fn_bs_lmts_constants
#  --------------------
fn_bs_lmts_constants() {
  set 'BS_DUMMY_PARAM' && shift
  test_assert ${LINENO:+"@${LINENO}"} -n "${BS_LIBMAP_SOURCED-}" || return $?
  test_assert ${LINENO:+"@${LINENO}"} -n "${BS_LIBMAP_VERSION_MAJOR-}" || return $?
  test_assert ${LINENO:+"@${LINENO}"} -n "${BS_LIBMAP_VERSION_MINOR-}" || return $?
  test_assert ${LINENO:+"@${LINENO}"} -n "${BS_LIBMAP_VERSION_PATCH-}" || return $?
  test_assert ${LINENO:+"@${LINENO}"} -n "${BS_LIBMAP_VERSION_FULL-}"  || return $?
  test_assert ${LINENO:+"@${LINENO}"} -n "${BS_LIBMAP_VERSION-}"       || return $?
  test_assert ${LINENO:+"@${LINENO}"} "${BS_LIBMAP_VERSION_MAJOR-}" -notmatch ".*[^0123456789].*" || return $?
  test_assert ${LINENO:+"@${LINENO}"} "${BS_LIBMAP_VERSION_MINOR-}" -notmatch ".*[^0123456789].*" || return $?
  test_assert ${LINENO:+"@${LINENO}"} "${BS_LIBMAP_VERSION_PATCH-}" -notmatch ".*[^0123456789].*" || return $?
  test_assert ${LINENO:+"@${LINENO}"} "${BS_LIBMAP_VERSION_FULL-}"  -notmatch ".*[^0123456789].*" || return $?
  test_assert ${LINENO:+"@${LINENO}"} "${BS_LIBMAP_VERSION-}" -match "BetterScripts 'libmap' v.*" || return $?
}

#_______________________________________________________________________________
#  fn_bs_lmts_map_new
#  --------------------------
fn_bs_lmts_map_new() {
  set 'BS_DUMMY_PARAM' && shift

  {
    TestMap=; unset TestMap
    test_run_expect_success   \
      ${LINENO:+"@${LINENO}"} \
      map_new                 \
        'TestMap'             \
        "${c_BS_LMTS__Key_1}=${c_BS_LMTS__Value_1}" \
        "${c_BS_LMTS__Key_2}=${c_BS_LMTS__Value_2}" || return $?

    test_run_expect_success   \
      ${LINENO:+"@${LINENO}"} \
      map_is_map 'TestMap'    || return $?

    {
        Size=; unset Size
        test_run_expect_success   \
          ${LINENO:+"@${LINENO}"} \
          map_size                \
            'TestMap'             \
            'Size'                || return $?

        test_assert               \
          ${LINENO:+"@${LINENO}"} \
          "${Size}" -eq 2         || return $?
    }

    {
        Output=; unset Output
        test_run_expect_success   \
          ${LINENO:+"@${LINENO}"} \
          map_get                 \
            'TestMap'             \
            "${c_BS_LMTS__Key_1}" \
            'Output'              || return $?

        test_assert                             \
          ${LINENO:+"@${LINENO}"}               \
          "${Output}" = "${c_BS_LMTS__Value_1}" || return $?
    }

    {
        Output=; unset Output
        test_run_expect_success   \
          ${LINENO:+"@${LINENO}"} \
          map_get                 \
            'TestMap'             \
            "${c_BS_LMTS__Key_2}" \
            'Output'              || return $?

        test_assert                             \
          ${LINENO:+"@${LINENO}"}               \
          "${Output}" = "${c_BS_LMTS__Value_2}" || return $?
    }
  }

  {
    TestMap=; unset TestMap
    # `bosh` doesn't correctly pipe this if it
    # is split into multiple commands - only the last
    # command is piped - the others are sent directly
    # to `TestMap`.
    TestMap=$(
        {
          printf  '%s=%s\n%s=%s\n' \
                  "${c_BS_LMTS__Key_1}" "${c_BS_LMTS__Value_1}" \
                  "${c_BS_LMTS__Key_2}" "${c_BS_LMTS__Value_2}"
        } | {
          test_run_expect_success   \
            ${LINENO:+"@${LINENO}"} \
            map_new
        }
      ) || return $?

    test_run_expect_success   \
      ${LINENO:+"@${LINENO}"} \
      map_is_map 'TestMap'    || return $?

    {
        Size=; unset Size
        test_run_expect_success   \
          ${LINENO:+"@${LINENO}"} \
          map_size                \
            'TestMap'             \
            'Size'                || return $?

        test_assert               \
          ${LINENO:+"@${LINENO}"} \
          "${Size}" -eq 2         || return $?
    }

    {
        Output=; unset Output
        test_run_expect_success   \
          ${LINENO:+"@${LINENO}"} \
          map_get                 \
            'TestMap'             \
            "${c_BS_LMTS__Key_1}" \
            'Output'              || return $?

        test_assert                             \
          ${LINENO:+"@${LINENO}"}               \
          "${Output}" = "${c_BS_LMTS__Value_1}" || return $?
    }

    {
        Output=; unset Output
        test_run_expect_success   \
          ${LINENO:+"@${LINENO}"} \
          map_get                 \
            'TestMap'             \
            "${c_BS_LMTS__Key_2}" \
            'Output'              || return $?

        test_assert                             \
          ${LINENO:+"@${LINENO}"}               \
          "${Output}" = "${c_BS_LMTS__Value_2}" || return $?
    }
  }
}

