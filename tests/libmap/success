  BS_TCC_Library=${1:?'[libmap::success::test_check_config]: Error: expected a library to source'}
  shift

  return
}

#_______________________________________________________________________________
#  test_run_all
#  ------------
#
#  Run tests for a specific library configuration.
#
#  NOTE: Preference based variables will be unset or set to specific values.
#        Variables required for platform workarounds will _not_ be changed if
#        currently set, but _may_ be set otherwise - this ensures platforms
#        that require workarounds don't try to use other code paths.
#_______________________________________________________________________________
test_run_all() { ## cSpell:Ignore BS_TRC_
  #---------------------------------------------------------
  #  Get Library File
  BS_TRC_Library=${1:?'[libmap::success::test_run_all]: Error: expected a library to source'}
  shift

  #---------------------------------------------------------
  test_print_config_info 'Type: NORMAL USAGE'
  #---------------------------------------------------------

  #---------------------------------------------------------
  # Source the tool
  # shellcheck source=SCRIPTDIR/../../libmap.sh
  . "${BS_TRC_Library:?}" || return $?
  #---------------------------------------------------------

  #---------------------------------------------------------
  #  Run the tests
  fn_bs_lmts_run_units ${1+"$@"}
  #---------------------------------------------------------
}

