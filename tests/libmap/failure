#_______________________________________________________________________________
#  fn_bs_lmtf_map_entry_format
#  -----------------------------
#
#  Tests the `KEY=VALUE`/`--key`/`--value` map entry parsing shared by
#  `map_new`/`map_add`/`map_set` (via `fn_bs_libmap_add_set_entries`).
fn_bs_lmtf_map_entry_format() {
  set 'BS_DUMMY_PARAM' && shift

  #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  #  Malformed Entry (no `=`, no separate `VALUE`)
  {
    TestMap=; unset 'TestMap'
    TestOutput=; unset 'TestOutput'
    test_run_expect_failure   \
      ${LINENO:+"@${LINENO}"} \
      --output=TestOutput     \
      map_add                 \
        'TestMap' 'lonelykey' || return $?

    test_assert ${LINENO:+"@${LINENO}"} "${TestOutput-}" -match '.*map_add.*invalid format for map entry.*' || return $?
  }

  #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  #  Null Key
  {
    TestMap=; unset 'TestMap'
    TestOutput=; unset 'TestOutput'
    test_run_expect_failure   \
      ${LINENO:+"@${LINENO}"} \
      --output=TestOutput     \
      map_add                 \
        'TestMap' '' 'value' || return $?

    test_assert ${LINENO:+"@${LINENO}"} "${TestOutput-}" -match '.*map_add.*null keys are not permitted.*' || return $?
  }

  #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  #  `--key` With No Key Given
  {
    TestMap=; unset 'TestMap'
    TestOutput=; unset 'TestOutput'
    test_run_expect_failure   \
      ${LINENO:+"@${LINENO}"} \
      --output=TestOutput     \
      map_add                 \
        'TestMap' '--key'    || return $?

    test_assert ${LINENO:+"@${LINENO}"} "${TestOutput-}" -match '.*map_add.*no key provided with --key.*' || return $?
  }

  #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  #  `--key=` With No Value Given
  {
    TestMap=; unset 'TestMap'
    TestOutput=; unset 'TestOutput'
    test_run_expect_failure   \
      ${LINENO:+"@${LINENO}"} \
      --output=TestOutput     \
      map_add                 \
        'TestMap' '--key=lonelykey' || return $?

    test_assert ${LINENO:+"@${LINENO}"} "${TestOutput-}" -match '.*map_add.*no value provided for key lonelykey.*' || return $?
  }
}

